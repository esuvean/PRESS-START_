  m_text: "\uC81C1\uC870: \uBCF8 \uC57D\uAD00\uC740 \uAC8C\uC784 \uC2E4\uD589 \uC804
    \uC900\uBE44 \uAC80\uC0AC\uB97C \uC704\uD574 \uC81C\uACF5\uB429\uB2C8\uB2E4.\r\n\uC81C2\uC870:
    \uC0AC\uC6A9\uC790\uB294 \uAC8C\uC784 \uC2E4\uD589\uC744 \uC704\uD574 \uBCF8
    \uC57D\uAD00\uC744 \uD655\uC778\uD574\uC57C \uD569\uB2C8\uB2E4.\r\n\uC81C3\uC870:
    \uC57D\uAD00\uC744 \uC77D\uC9C0 \uC54A\uC544 \uBC1C\uC0DD\uD558\uB294 \uD63C\uB780\uC5D0
    \uB300\uD574 \uC2DC\uC2A4\uD15C\uC740 \uCC45\uC784\uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C4\uC870:
    \uBCF8 \uC2DC\uC2A4\uD15C\uC740 \uC0AC\uC6A9\uC790\uC758 \uC785\uB825 \uC0C1\uD0DC\uB97C
    \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C5\uC870: \uC0AC\uC6A9\uC790\uC758
    \uB9C8\uC6B0\uC2A4 \uC774\uB3D9\uC740 \uC815\uC0C1\uC801\uC778 \uAC80\uC0AC \uACFC\uC815\uC73C\uB85C
    \uAE30\uB85D\uB429\uB2C8\uB2E4.\r\n\uC81C6\uC870: \uD074\uB9AD\uC740 \uC0AC\uC6A9\uC790\uC758
    \uC2E4\uD589 \uC758\uC0AC\uB97C \uB098\uD0C0\uB0B4\uB294 \uAC83\uC73C\uB85C \uAC04\uC8FC\uB429\uB2C8\uB2E4.\r\n\uC81C7\uC870:
    \uC798\uBABB\uB41C \uD074\uB9AD \uC5ED\uC2DC \uC815\uC0C1\uC801\uC778 \uC785\uB825
    \uB370\uC774\uD130\uB85C \uC800\uC7A5\uB429\uB2C8\uB2E4.\r\n\uC81C8\uC870: \uAC8C\uC784
    \uC2E4\uD589 \uC900\uBE44 \uACFC\uC815\uC740 \uC608\uC0C1\uBCF4\uB2E4 \uAE38\uC5B4\uC9C8
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C9\uC870: \uC900\uBE44 \uAC80\uC0AC\uB294
    \uC0AC\uC6A9\uC790\uC758 \uC778\uB0B4\uC2EC\uC744 \uCE21\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
    \uC544\uB9C8\uB3C4\uC694.\r\n\uC81C10\uC870: \uC2DC\uC2A4\uD15C \uC624\uB958
    \uBC1C\uC0DD \uC2DC \uACB0\uACFC\uB294 \uC5B8\uC81C\uB4E0 \uBCC0\uACBD\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C11\uC870: \uBCF8 \uC57D\uAD00\uC740
    \uC608\uACE0 \uC5C6\uC774 \uC218\uC815\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C12\uC870:
    \uC218\uC815\uB41C \uC57D\uAD00\uC740 \uC2DC\uC2A4\uD15C\uC5D0 \uAC8C\uC2DC\uB41C
    \uC2DC\uC810\uBD80\uD130 \uD6A8\uB825\uC774 \uBC1C\uC0DD\uD569\uB2C8\uB2E4.\r\n\uC81C13\uC870:
    \uD50C\uB808\uC774\uC5B4\uB294 \uBC84\uD2BC\uC774 \uB3C4\uB9DD\uAC00\uB354\uB77C\uB3C4
    \uCC45\uC784\uC744 \uBB3B\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C14\uC870:
    \uC2DC\uC791 \uBC84\uD2BC\uC758 \uC704\uCE58\uB294 \uC2DC\uC2A4\uD15C\uC758 \uD310\uB2E8\uC5D0
    \uB530\uB77C \uBCC0\uACBD\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C15\uC870:
    \uC2DC\uC791 \uBC84\uD2BC\uC774 \uBCF4\uC774\uC9C0 \uC54A\uB294 \uACBD\uC6B0
    \uC8FC\uBCC0\uC744 \uD655\uC778\uD558\uC2ED\uC2DC\uC624.\r\n\uC81C16\uC870: \uD654\uBA74\uC5D0
    \uD45C\uC2DC\uB41C \uBAA8\uB4E0 \uBC84\uD2BC\uC774 \uC2E4\uC81C \uBC84\uD2BC\uC774\uB77C\uB294
    \uBCF4\uC7A5\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C17\uC870: \uBC84\uD2BC\uC758
    \uC678\uD615\uACFC \uAE30\uB2A5\uC740 \uC11C\uB85C \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C18\uC870:
    \uC9C0\uB098\uCE58\uAC8C \uC815\uC0C1\uC801\uC778 \uBC84\uD2BC\uC740 \uC758\uC2EC\uD574
    \uBCFC \uD544\uC694\uAC00 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C19\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uC0AC\uC6A9\uC790\uAC00 \uBB34\uC5C7\uC744 \uD074\uB9AD\uD588\uB294\uC9C0 \uAE30\uC5B5\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C20\uC870: \uC0AC\uC6A9\uC790\uAC00
    \uAE30\uC5B5\uD558\uC9C0 \uBABB\uD558\uB354\uB77C\uB3C4 \uC2DC\uC2A4\uD15C\uC740
    \uAE30\uC5B5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C21\uC870: \uBCF8
    \uAC80\uC0AC \uC911 \uD654\uBA74 \uBC30\uCE58\uB294 \uC784\uC758\uB85C \uBCC0\uACBD\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C22\uC870: \uC77C\uBD80 \uC548\uB0B4\uCC3D\uC740
    \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C23\uC870: \uC77C\uBD80
    \uC548\uB0B4\uCC3D\uC740 \uB2EB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C24\uC870:
    \uC77C\uBD80 \uC548\uB0B4\uCC3D\uC740 \uB2EB\uC9C0 \uC54A\uB294 \uAC83\uC774
    \uB354 \uB098\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C25\uC870: \uCC3D\uC744
    \uB2EB\uC558\uB2E4\uACE0 \uD574\uC11C \uBB38\uC81C\uAC00 \uD574\uACB0\uB418\uC5C8\uB2E4\uB294
    \uC758\uBBF8\uB294 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C26\uC870: \uD558\uB098\uC758
    \uCC3D\uC744 \uB2EB\uC73C\uBA74 \uB2E4\uB978 \uCC3D\uC774 \uB098\uD0C0\uB0A0
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C27\uC870: \uBCF8 \uC2DC\uC2A4\uD15C\uC740
    \uC608\uC0C1\uCE58 \uBABB\uD55C \uBC29\uC2DD\uC73C\uB85C \uC791\uB3D9\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C28\uC870: \uBCF8 \uAC80\uC0AC\uB294 \uAC8C\uC784\uC774
    \uC544\uB2D0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C29\uC870: \uBCF8 \uAC80\uC0AC\uAC00
    \uAC8C\uC784\uC778\uC9C0 \uC5EC\uBD80\uB294 \uD604\uC7AC \uC911\uC694\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C30\uC870: \uC0AC\uC6A9\uC790\uB294 \uACC4\uC18D
    \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C31\uC870: \uC2A4\uD06C\uB864\uBC14\uB294
    \uC815\uC0C1\uC801\uC73C\uB85C \uC791\uB3D9\uD558\uB294 \uAC83\uC744 \uC6D0\uCE59\uC73C\uB85C
    \uD569\uB2C8\uB2E4.\r\n\uC81C32\uC870: \uC815\uC0C1\uC801\uC73C\uB85C \uC791\uB3D9\uD558\uC9C0
    \uC54A\uB294 \uACBD\uC6B0\uC5D0\uB3C4 \uC815\uC0C1\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C33\uC870:
    \uC57D\uAD00\uC758 \uAE38\uC774\uB294 \uC2DC\uC2A4\uD15C \uC0C1\uD669\uC5D0 \uB530\uB77C
    \uBCC0\uACBD\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C34\uC870: \uC544\uB798\uB85C
    \uC774\uB3D9\uD55C\uB2E4\uACE0 \uBC18\uB4DC\uC2DC \uB05D\uC5D0 \uAC00\uAE4C\uC6CC\uC9C0\uB294
    \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C35\uC870: \uC704\uB85C \uC774\uB3D9\uD588\uB2E4\uACE0
    \uD574\uC11C \uC9C4\uD589 \uC0C1\uD669\uC774 \uCD08\uAE30\uD654\uB41C \uAC83\uC740
    \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C36\uC870: \uB2E8, \uC2E4\uC81C\uB85C \uCD08\uAE30\uD654\uB420
    \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C37\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uC57D\uAD00\uC758 \uD604\uC7AC \uC704\uCE58\uB97C \uC800\uC7A5\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C38\uC870: \uC800\uC7A5\uB41C \uC704\uCE58\uB294
    \uC0AC\uC6A9\uC790\uC758 \uB3D9\uC758 \uC5C6\uC774 \uCD08\uAE30\uD654\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C39\uC870: \uCD08\uAE30\uD654\uB294 \uC624\uB958\uAC00
    \uC544\uB2CC \uC815\uC0C1\uC801\uC778 \uAC80\uC0AC \uACFC\uC815\uC785\uB2C8\uB2E4.\r\n\uC81C40\uC870:
    \uBC84\uD2BC\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC744 \uB54C\uC5D0\uB3C4 \uC5EC\uB7EC\uBD84\uC740
    \uC874\uC7AC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C41\uC870: \uC774\uBBF8
    \uD50C\uB808\uC774\uD55C \uC2DC\uAC04\uC740 \uBC18\uD658\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C42\uC870:
    \uACBD\uACFC\uB41C \uC2DC\uAC04\uC758 \uC591\uACFC \uBB34\uAD00\uD558\uAC8C \uAC80\uC0AC\uB294
    \uACC4\uC18D\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C43\uC870: \uAC8C\uC784
    \uC2E4\uD589 \uC900\uBE44 \uC2DC\uAC04\uC740 \uD50C\uB808\uC774 \uC2DC\uAC04\uC5D0
    \uD3EC\uD568\uB418\uC9C0 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C44\uC870:
    \uBC18\uB300\uB85C \uD50C\uB808\uC774 \uC2DC\uAC04\uC5D0 \uD3EC\uD568\uB420 \uC218\uB3C4
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C45\uC870: \uC2DC\uAC04 \uD45C\uC2DC\uB294
    \uC2E4\uC81C \uC2DC\uAC04\uACFC \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C46\uC870:
    \uD0C0\uC774\uBA38\uAC00 \uBA48\uCD94\uB354\uB77C\uB3C4 \uAC80\uC0AC\uAC00 \uC885\uB8CC\uB41C
    \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C47\uC870: \uD0C0\uC774\uBA38\uAC00
    \uC99D\uAC00\uD558\uB354\uB77C\uB3C4 \uACE0\uC7A5\uC774 \uC544\uB2D0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C48\uC870:
    \uB0A8\uC740 \uC2DC\uAC04\uC740 \uC0AC\uC6A9\uC790\uC758 \uD589\uB3D9\uC5D0 \uB530\uB77C
    \uB2EC\uB77C\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C49\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uC2DC\uAC04\uC744 \uC815\uD655\uD788 \uCE21\uC815\uD558\uACE0 \uC788\uB2E4\uACE0
    \uC8FC\uC7A5\uD569\uB2C8\uB2E4.\r\n\uC81C50\uC870: \uD574\uB2F9 \uC8FC\uC7A5\uC5D0
    \uB300\uD55C \uAC80\uC99D\uC740 \uC81C\uACF5\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C51\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uC0AC\uC6A9\uC790\uC758 \uD589\uB3D9\uC744 \uAD00\uCC30\uD558\uACE0
    \uAE30\uB85D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C52\uC870: \uC0AC\uC6A9\uC790\uAC00
    \uC57D\uAD00\uC744 \uC77D\uC9C0 \uC54A\uC544\uB3C4 \uC2DC\uC2A4\uD15C\uC740 \uB3D9\uC758\uD55C
    \uAC83\uC73C\uB85C \uD310\uB2E8\uD569\uB2C8\uB2E4.\r\n\uC81C53\uC870: \uC0AC\uC6A9\uC790\uAC00
    \uC57D\uAD00\uC744 \uC77D\uC5C8\uB294\uC9C0 \uC5EC\uBD80\uB294 \uBCC4\uB3C4\uB85C
    \uD655\uC778\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C54\uC870: \uB2E8,
    \uB05D\uAE4C\uC9C0 \uB0B4\uB824\uC654\uB294\uC9C0\uB294 \uD655\uC778\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C55\uC870: \uC0AC\uC6A9\uC790\uC758 \uC2A4\uD06C\uB864
    \uC18D\uB3C4\uB294 \uAC80\uC0AC \uB370\uC774\uD130\uB85C \uD65C\uC6A9\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C56\uC870: \uC0AC\uC6A9\uC790\uAC00 \uBE60\uB974\uAC8C
    \uB0B4\uB838\uB2E4\uACE0 \uD574\uC11C \uB0B4\uC6A9\uC744 \uC774\uD574\uD55C \uAC83\uC73C\uB85C
    \uBCF4\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C57\uC870: \uCC9C\uCC9C\uD788
    \uC77D\uC5C8\uB2E4\uACE0 \uD574\uC11C \uB0B4\uC6A9\uC744 \uC774\uD574\uD55C \uAC83\uC73C\uB85C
    \uBCF4\uC9C0\uB3C4 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C58\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uC774\uD574 \uC5EC\uBD80\uBCF4\uB2E4 \uC9C4\uD589 \uC5EC\uBD80\uB97C \uC911\uC694\uD558\uAC8C
    \uD310\uB2E8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C59\uC870: \uC9C4\uD589\uC744
    \uC911\uB2E8\uD558\uBA74 \uC900\uBE44 \uC0C1\uD0DC\uAC00 \uC720\uC9C0\uB418\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C60\uC870: \uC0AC\uC6A9\uC790\uB294
    \uC5B8\uC81C\uB4E0 \uACC4\uC18D \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C61\uC870:
    \uD78C\uD2B8\uB294 \uD544\uC694\uD55C \uACBD\uC6B0 \uC81C\uACF5\uB429\uB2C8\uB2E4.\r\n\uC81C62\uC870:
    \uD78C\uD2B8\uAC00 \uBC18\uB4DC\uC2DC \uC815\uB2F5\uC744 \uC54C\uB824\uC8FC\uB294
    \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C63\uC870: \uD78C\uD2B8\uB97C
    \uBBFF\uC744\uC9C0 \uC5EC\uBD80\uB294 \uC0AC\uC6A9\uC790\uC758 \uD310\uB2E8\uC5D0
    \uB530\uB985\uB2C8\uB2E4.\r\n\uC81C64\uC870: \uC2DC\uC2A4\uD15C \uBA54\uC2DC\uC9C0\uAC00
    \uD56D\uC0C1 \uC0AC\uC2E4\uC774\uB77C\uB294 \uBCF4\uC7A5\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C65\uC870:
    \uD654\uBA74\uC758 \uC791\uC740 \uAE00\uC528\uB294 \uC911\uC694\uD55C \uB0B4\uC6A9\uC744
    \uD3EC\uD568\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C66\uC870: \uD654\uBA74\uC758
    \uD070 \uAE00\uC528\uB294 \uC911\uC694\uD558\uC9C0 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C67\uC870:
    \uAC15\uC870\uB41C \uC694\uC18C\uAC00 \uBC18\uB4DC\uC2DC \uC120\uD0DD \uB300\uC0C1\uC778
    \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C68\uC870: \uC6C0\uC9C1\uC774\uB294
    \uC694\uC18C\uAC00 \uBC18\uB4DC\uC2DC \uC704\uD5D8\uD55C \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C69\uC870:
    \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294 \uC694\uC18C\uAC00 \uC548\uC804\uD558\uB2E4\uB294
    \uBCF4\uC7A5\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C70\uC870: \uC0AC\uC6A9\uC790\uB294
    \uD654\uBA74 \uC804\uCCB4\uB97C \uD655\uC778\uD558\uB294 \uAC83\uC774 \uC88B\uC2B5\uB2C8\uB2E4.\r\n\uC81C71\uC870:
    \uC624\uB958 \uBA54\uC2DC\uC9C0\uB294 \uAC80\uC0AC \uACFC\uC815\uC5D0\uC11C \uD45C\uC2DC\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C72\uC870: \uC624\uB958 \uBA54\uC2DC\uC9C0\uAC00
    \uD45C\uC2DC\uB418\uB354\uB77C\uB3C4 \uC2DC\uC2A4\uD15C\uC740 \uACC4\uC18D \uC791\uB3D9\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C73\uC870: \uC2DC\uC2A4\uD15C\uC774
    \uBA48\uCD98 \uAC83\uCC98\uB7FC \uBCF4\uC5EC\uB3C4 \uC2E4\uC81C\uB85C \uBA48\uCD98
    \uAC83\uC740 \uC544\uB2D0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C74\uC870:
    \uB85C\uB529 \uD654\uBA74\uC774 \uB05D\uB0AC\uB2E4\uACE0 \uD574\uC11C \uC2E4\uD589\uC774
    \uC644\uB8CC\uB41C \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C75\uC870:
    99%\uC640 100%\uC758 \uCC28\uC774\uB294 \uC2DC\uC2A4\uD15C\uC774 \uACB0\uC815\uD569\uB2C8\uB2E4.\r\n\uC81C76\uC870:
    \uC644\uB8CC \uD45C\uC2DC\uAC00 \uB098\uD0C0\uB0AC\uB2E4\uACE0 \uD574\uC11C \uBAA8\uB4E0
    \uACFC\uC815\uC774 \uB05D\uB09C \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C77\uC870:
    \uC900\uBE44 \uC644\uB8CC\uC640 \uC2E4\uD589 \uC644\uB8CC\uB294 \uC11C\uB85C
    \uB2E4\uB978 \uC0C1\uD0DC\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C78\uC870:
    \uD604\uC7AC \uC138\uC158 \uC0C1\uD0DC\uB294 \uC5B8\uC81C\uB4E0 \uBCC0\uACBD\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C79\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uD604\uC7AC \uC138\uC158\uC744 \uC774\uBBF8 \uC2E4\uD589 \uC911\uC774\uB77C\uACE0
    \uD310\uB2E8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C80\uC870: \uD574\uB2F9
    \uD310\uB2E8\uC740 \uC0AC\uC6A9\uC790\uC5D0\uAC8C \uC989\uC2DC \uC54C\uB824\uC9C0\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C81\uC870: \uC0AC\uC6A9\uC790\uB294
    \uC2DC\uC791 \uBC84\uD2BC\uC744 \uCC3E\uC744 \uAD8C\uB9AC\uAC00 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C82\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uC2DC\uC791 \uBC84\uD2BC\uC744 \uC228\uAE38 \uAD8C\uB9AC\uAC00
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C83\uC870: \uC2DC\uC791 \uBC84\uD2BC\uC740
    \uD654\uBA74 \uBC16\uC73C\uB85C \uC774\uB3D9\uD558\uC9C0 \uC54A\uB294 \uAC83\uC744
    \uAD8C\uC7A5\uD569\uB2C8\uB2E4.\r\n\uC81C84\uC870: \uAD8C\uC7A5 \uC0AC\uD56D\uC740
    \uBC18\uB4DC\uC2DC \uC9C0\uCF1C\uC9C0\uB294 \uADDC\uCE59\uC774 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C85\uC870:
    \uB3D9\uC77C\uD55C \uBC84\uD2BC\uC774 \uC5EC\uB7EC \uAC1C \uD45C\uC2DC\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C86\uC870: \uC5EC\uB7EC \uBC84\uD2BC
    \uC911 \uC9C4\uC9DC \uBC84\uD2BC\uC740 \uD558\uB098\uC77C \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C87\uC870:
    \uC9C4\uC9DC \uBC84\uD2BC\uC774 \uD558\uB098\uB77C\uB294 \uBCF4\uC7A5\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C88\uC870:
    \uAC00\uC9DC \uBC84\uD2BC\uC744 \uB20C\uB7EC\uB3C4 \uAC80\uC0AC\uB294 \uC885\uB8CC\uB418\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C89\uC870: \uC798\uBABB\uB41C \uC120\uD0DD\uC740
    \uC2E4\uD328 \uD69F\uC218\uB85C \uAE30\uB85D\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C90\uC870:
    \uC2E4\uD328 \uD69F\uC218\uAC00 \uC99D\uAC00\uD558\uB354\uB77C\uB3C4 \uAC8C\uC784
    \uC624\uBC84\uB294 \uBC1C\uC0DD\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C91\uC870:
    \uC0AC\uC6A9\uC790\uB294 \uD544\uC694\uD55C \uB9CC\uD07C \uB2E4\uC2DC \uC2DC\uB3C4\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C92\uC870: \uBC18\uBCF5 \uC2DC\uB3C4\uB294
    \uC2DC\uC2A4\uD15C\uC5D0 \uC758\uD574 \uC815\uC0C1\uC801\uC778 \uD589\uB3D9\uC73C\uB85C
    \uD310\uB2E8\uB429\uB2C8\uB2E4.\r\n\uC81C93\uC870: \uC2DC\uC2A4\uD15C\uC740 \uC0AC\uC6A9\uC790\uC758
    \uD3EC\uAE30 \uC5EC\uBD80\uB97C \uD655\uC778\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C94\uC870:
    \uACC4\uC18D \uC9C4\uD589\uD55C \uC0AC\uC6A9\uC790\uB294 \uB2E4\uC74C \uAC80\uC0AC\uB85C
    \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C95\uC870: \uB2E4\uC74C
    \uAC80\uC0AC\uAC00 \uB9C8\uC9C0\uB9C9 \uAC80\uC0AC\uB77C\uB294 \uBCF4\uC7A5\uC740
    \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C96\uC870: \uB9C8\uC9C0\uB9C9\uC774\uB77C\uB294
    \uD45C\uD604\uC740 \uC2DC\uC2A4\uD15C \uC0C1\uD669\uC5D0 \uB530\uB77C \uB2EC\uB77C\uC9C8
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C97\uC870: \uD604\uC7AC \uBCF4\uACE0
    \uC788\uB294 \uD654\uBA74\uC774 \uC900\uBE44 \uACFC\uC815\uC774\uB77C\uB294 \uBCF4\uC7A5\uC740
    \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C98\uC870: \uC9C0\uAE08\uAE4C\uC9C0 \uC218\uD589\uD55C
    \uD589\uB3D9\uC774 \uAC8C\uC784\uC774\uC5C8\uB294\uC9C0\uB294 \uC544\uC9C1 \uD310\uB2E8\uD560
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C99\uC870: \uC57D\uAD00\uC758 \uB05D\uC740
    \uC0C8\uB85C\uC6B4 \uC57D\uAD00\uC758 \uC2DC\uC791\uC77C \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C100\uC870:
    \uBCF8 \uBB38\uC11C\uC758 \uCCAB \uBC88\uC9F8 \uD655\uC778 \uAD6C\uAC04\uC774
    \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C101\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uC2A4\uD06C\uB864 \uC704\uCE58\uB97C \uC784\uC758\uB85C \uC870\uC815\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C102\uC870: \uC2A4\uD06C\uB864 \uC704\uCE58
    \uC870\uC815\uC740 \uC0AC\uC6A9\uC790 \uD3B8\uC758\uB97C \uC704\uD55C \uAC83\uC77C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C103\uC870: \uC0AC\uC6A9\uC790 \uD3B8\uC758\uC758
    \uC815\uC758\uB294 \uC2DC\uC2A4\uD15C\uC774 \uACB0\uC815\uD569\uB2C8\uB2E4.\r\n\uC81C104\uC870:
    \uBB38\uC11C\uAC00 \uAC11\uC790\uAE30 \uC704\uB85C \uC774\uB3D9\uD558\uB354\uB77C\uB3C4
    \uB2F9\uD669\uD558\uC9C0 \uB9C8\uC2ED\uC2DC\uC624.\r\n\uC81C105\uC870: \uBB38\uC11C\uAC00
    \uAC11\uC790\uAE30 \uC544\uB798\uB85C \uC774\uB3D9\uD558\uB354\uB77C\uB3C4 \uC5ED\uC2DC
    \uB2F9\uD669\uD558\uC9C0 \uB9C8\uC2ED\uC2DC\uC624.\r\n\uC81C106\uC870: \uC2A4\uD06C\uB864\uBC14\uC758
    \uAE38\uC774\uB294 \uBB38\uC11C\uC758 \uC2E4\uC81C \uAE38\uC774\uC640 \uC77C\uCE58\uD558\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C107\uC870: \uC2A4\uD06C\uB864\uBC14\uAC00
    \uC9E7\uC544 \uBCF4\uC5EC\uB3C4 \uB05D\uC774 \uAC00\uAE4C\uC6B4 \uAC83\uC740
    \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C108\uC870: \uC2A4\uD06C\uB864\uBC14\uAC00
    \uAE38\uC5B4 \uBCF4\uC5EC\uB3C4 \uB05D\uC774 \uBA3C \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C109\uC870:
    \uD654\uBA74\uC5D0 \uBCF4\uC774\uB294 \uC870\uD56D \uC218\uB294 \uC2E4\uC81C
    \uC870\uD56D \uC218\uC640 \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C110\uC870:
    \uC77C\uBD80 \uC870\uD56D\uC740 \uC0DD\uB7B5\uB418\uC5B4 \uD45C\uC2DC\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C111\uC870: \uC0DD\uB7B5\uB41C \uC870\uD56D\uC5D0\uB3C4
    \uB3D9\uC758\uD55C \uAC83\uC73C\uB85C \uAC04\uC8FC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C112\uC870:
    \uC870\uD56D \uBC88\uD638\uAC00 \uC5F0\uC18D\uC801\uC774\uC9C0 \uC54A\uC544\uB3C4
    \uC2DC\uC2A4\uD15C\uC740 \uC815\uC0C1\uC785\uB2C8\uB2E4.\r\n\uC81C113\uC870:
    \uB3D9\uC77C\uD55C \uC870\uD56D \uBC88\uD638\uAC00 \uB450 \uBC88 \uB098\uD0C0\uB0A0
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C114\uC870: \uB3D9\uC77C\uD55C \uBB38\uC7A5\uC774
    \uBC18\uBCF5\uB418\uC5B4\uB3C4 \uC624\uB958\uAC00 \uC544\uB2D0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C115\uC870:
    \uBC18\uBCF5\uB418\uB294 \uBB38\uC7A5\uC744 \uBC1C\uACAC\uD588\uB2E4\uBA74 \uACC4\uC18D
    \uC77D\uC73C\uC2ED\uC2DC\uC624.\r\n\uC81C116\uC870: \uBC18\uBCF5\uB418\uC9C0
    \uC54A\uB294 \uBB38\uC7A5\uC744 \uBC1C\uACAC\uD574\uB3C4 \uACC4\uC18D \uC77D\uC73C\uC2ED\uC2DC\uC624.\r\n\uC81C117\uC870:
    \uC0AC\uC6A9\uC790\uB294 \uC57D\uAD00\uC758 \uB05D\uC744 \uC9C1\uC811 \uD655\uC778\uD574\uC57C
    \uD569\uB2C8\uB2E4.\r\n\uC81C118\uC870: \uB05D\uC774\uB77C\uACE0 \uD45C\uC2DC\uB41C
    \uC9C0\uC810\uC774 \uC2E4\uC81C \uB05D\uC774\uB77C\uB294 \uBCF4\uC7A5\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C119\uC870:
    \uB05D \uC544\uB798\uC5D0 \uCD94\uAC00 \uB0B4\uC6A9\uC774 \uC788\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C120\uC870: \uCD94\uAC00 \uB0B4\uC6A9 \uC544\uB798\uC5D0\uB3C4
    \uCD94\uAC00 \uB0B4\uC6A9\uC774 \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C121\uC870:
    \uC2A4\uD06C\uB864 \uD720 \uC785\uB825\uC740 \uD55C \uBC88\uC5D0 \uD55C \uB2E8\uACC4\uC529
    \uCC98\uB9AC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C122\uC870: \uBE60\uB978
    \uC2A4\uD06C\uB864 \uC785\uB825\uC740 \uC77C\uBD80 \uAD6C\uAC04\uC5D0\uC11C \uC81C\uD55C\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C123\uC870: \uC2A4\uD06C\uB864 \uC18D\uB3C4
    \uC81C\uD55C\uC740 \uC2DC\uC2A4\uD15C \uBCF4\uD638\uB97C \uC704\uD55C \uC870\uCE58\uC785\uB2C8\uB2E4.\r\n\uC81C124\uC870:
    \uBCF4\uD638 \uB300\uC0C1\uC5D0 \uC0AC\uC6A9\uC790\uAC00 \uD3EC\uD568\uB418\uB294\uC9C0\uB294
    \uBA85\uD655\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C125\uC870: \uBB38\uC11C
    \uC774\uB3D9 \uC911 \uBC84\uD2BC\uC774 \uC7A0\uC2DC \uBCF4\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C126\uC870:
    \uC7A0\uC2DC \uBCF4\uC778 \uBC84\uD2BC\uC744 \uC989\uC2DC \uB204\uB97C \uC218
    \uC788\uB2E4\uB294 \uBCF4\uC7A5\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C127\uC870:
    \uBC84\uD2BC\uC740 \uC0AC\uC6A9\uC790\uAC00 \uC811\uADFC\uD558\uBA74 \uC704\uCE58\uB97C
    \uBCC0\uACBD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C128\uC870: \uCCAB
    \uBC88\uC9F8 \uC811\uADFC\uC740 \uD14C\uC2A4\uD2B8 \uC785\uB825\uC73C\uB85C \uCDE8\uAE09\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C129\uC870: \uB450 \uBC88\uC9F8 \uC811\uADFC\uBD80\uD130\uB294
    \uC815\uC0C1 \uC785\uB825\uC73C\uB85C \uC778\uC815\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C130\uC870:
    \uC138 \uBC88\uC9F8 \uC811\uADFC\uC774 \uD544\uC694\uD55C \uACBD\uC6B0\uB3C4
    \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C131\uC870: \uBB38\uC11C
    \uD558\uB2E8\uC5D0 \uB3C4\uB2EC\uD558\uBA74 \uC2DC\uC2A4\uD15C\uC740 \uC704\uCE58\uB97C
    \uAE30\uB85D\uD569\uB2C8\uB2E4.\r\n\uC81C132\uC870: \uAE30\uB85D\uB41C \uC704\uCE58\uB294
    \uB2E4\uC74C \uC2DC\uB3C4\uC5D0\uC11C \uC0AC\uC6A9\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C133\uC870:
    \uB2E4\uC74C \uC2DC\uB3C4\uC5D0\uC11C \uAE30\uB85D\uAC12\uC774 \uBB34\uC2DC\uB420
    \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C134\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uC0AC\uC6A9\uC790\uC758 \uBC18\uBCF5 \uD589\uB3D9\uC744 \uD559\uC2B5\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C135\uC870: \uB2E8, \uD559\uC2B5\uD558\uC9C0
    \uC54A\uB294\uB2E4\uACE0 \uB9D0\uD588\uC744 \uBFD0\uC785\uB2C8\uB2E4.\r\n\uC81C136\uC870:
    \uBB38\uC11C \uC548\uC758 \uACBD\uACE0 \uBB38\uAD6C\uB294 \uC2E4\uC81C \uACBD\uACE0\uC77C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C137\uC870: \uC7A5\uB09C\uCC98\uB7FC
    \uBCF4\uC774\uB294 \uBB38\uAD6C\uB3C4 \uC2E4\uC81C \uACBD\uACE0\uC77C \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C138\uC870: \uC2E4\uC81C \uACBD\uACE0\uCC98\uB7FC
    \uBCF4\uC774\uB294 \uBB38\uAD6C\uAC00 \uC7A5\uB09C\uC77C \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C139\uC870:
    \uD310\uB2E8\uC740 \uC0AC\uC6A9\uC790\uC5D0\uAC8C \uB9E1\uACA8\uC9D1\uB2C8\uB2E4.\r\n\uC81C140\uC870:
    \uD310\uB2E8 \uACB0\uACFC\uC5D0 \uB300\uD55C \uCC45\uC784\uC740 \uC0AC\uC6A9\uC790\uC5D0\uAC8C
    \uC788\uC9C0 \uC54A\uC744 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C141\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uD310\uB2E8 \uACB0\uACFC\uB97C \uBCC4\uB3C4\uB85C \uC800\uC7A5\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C142\uC870: \uC800\uC7A5 \uC5EC\uBD80\uB294
    \uD654\uBA74\uC5D0 \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C143\uC870:
    \uBB38\uC11C\uC758 \uC77C\uBD80\uB294 \uC2DC\uAC01\uC801 \uC7A5\uC2DD\uC77C \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C144\uC870: \uC2DC\uAC01\uC801 \uC7A5\uC2DD\uCC98\uB7FC
    \uBCF4\uC774\uB294 \uC77C\uBD80\uB294 \uC911\uC694\uD55C \uC815\uBCF4\uC77C \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C145\uC870: \uC810\uC120\uC740 \uAD6C\uBD84\uC120\uC77C
    \uC218\uB3C4 \uC788\uACE0 \uC544\uB2D0 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C146\uC870:
    \uAE5C\uBE61\uC774\uB294 \uC694\uC18C\uB294 \uD78C\uD2B8\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C147\uC870:
    \uAE5C\uBE61\uC774\uC9C0 \uC54A\uB294 \uC694\uC18C\uB3C4 \uD78C\uD2B8\uC77C \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C148\uC870: \uC0AC\uC6A9\uC790\uB294 \uBAA8\uB4E0
    \uAC00\uB2A5\uC131\uC744 \uACE0\uB824\uD560 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C149\uC870:
    \uADF8\uB7FC\uC5D0\uB3C4 \uC2DC\uC2A4\uD15C\uC740 \uBAA8\uB4E0 \uAC00\uB2A5\uC131\uC744
    \uACE0\uB824\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C150\uC870: \uACC4\uC18D
    \uC2A4\uD06C\uB864\uD558\uB294 \uAC83\uC774 \uAC00\uC7A5 \uB2E8\uC21C\uD55C \uD574\uACB0
    \uBC29\uBC95\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C151\uC870: \uBB38\uC11C
    \uB0B4 \uBC84\uD2BC\uC740 \uC77C\uBC18 UI \uBC84\uD2BC\uACFC \uB3D9\uC77C\uD558\uAC8C
    \uBCF4\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C152\uC870: \uB3D9\uC77C\uD558\uAC8C
    \uBCF4\uC774\uB354\uB77C\uB3C4 \uB3D9\uC77C\uD558\uAC8C \uC791\uB3D9\uD55C\uB2E4\uB294
    \uBCF4\uC7A5\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C153\uC870: \uBC84\uD2BC\uC758
    \uC0C9\uC0C1\uC740 \uC0C1\uD0DC\uC5D0 \uB530\uB77C \uBCC0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C154\uC870:
    \uC0C9\uC0C1\uC774 \uBCC0\uD558\uC9C0 \uC54A\uC544\uB3C4 \uC0C1\uD0DC\uAC00 \uBCC0\uD588\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C155\uC870: \uBC84\uD2BC \uC704\uC5D0
    \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uB294 \uD589\uC704\uB294 \uC785\uB825\uC73C\uB85C
    \uAC04\uC8FC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C156\uC870: \uD074\uB9AD\uD558\uC9C0
    \uC54A\uC544\uB3C4 \uBC84\uD2BC\uC774 \uBC18\uC751\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C157\uC870:
    \uBC84\uD2BC\uC774 \uBC18\uC751\uD558\uC9C0 \uC54A\uC544\uB3C4 \uD074\uB9AD\uC740
    \uAE30\uB85D\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C158\uC870: \uCCAB
    \uBC88\uC9F8 \uD638\uBC84 \uC785\uB825\uC740 \uC704\uCE58 \uCD08\uAE30\uD654\uB97C
    \uBC1C\uC0DD\uC2DC\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C159\uC870:
    \uC704\uCE58 \uCD08\uAE30\uD654\uB294 \uC2E4\uD328\uB85C \uACC4\uC0B0\uB418\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C160\uC870: \uCD08\uAE30\uD654
    \uD6C4 \uC0AC\uC6A9\uC790\uB294 \uB2E4\uC2DC \uD558\uB2E8\uC73C\uB85C \uC774\uB3D9\uD574\uC57C
    \uD569\uB2C8\uB2E4.\r\n\uC81C161\uC870: \uB2E4\uC2DC \uC774\uB3D9\uD558\uB294
    \uACFC\uC815\uC740 \uC0DD\uB7B5\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C162\uC870:
    \uB2E8, \uD78C\uD2B8 \uC870\uAC74\uC774 \uCDA9\uC871\uB418\uBA74 \uACFC\uC815\uC774
    \uB2E8\uCD95\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C163\uC870: 30\uCD08
    \uC774\uC0C1 \uBA38\uBB34\uB974\uBA74 \uC2A4\uD06C\uB864\uBC14\uAC00 \uAC15\uC870\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C164\uC870: \uAC15\uC870 \uD6A8\uACFC\uB294
    \uC7A0\uC2DC \uD6C4 \uC0AC\uB77C\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C165\uC870:
    \uAC15\uC870 \uD6A8\uACFC\uB97C \uB193\uCCD0\uB3C4 \uC9C4\uD589\uC5D0\uB294 \uBB38\uC81C\uAC00
    \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C166\uC870: \uCCAB \uBC88\uC9F8 \uCD08\uAE30\uD654
    \uC774\uD6C4 \uC2A4\uD06C\uB864 \uC18D\uB3C4\uAC00 \uC99D\uAC00\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C167\uC870: \uC99D\uAC00\uB41C \uC2A4\uD06C\uB864
    \uC18D\uB3C4\uB294 \uB2E4\uC2DC \uAC10\uC18C\uD558\uC9C0 \uC54A\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C168\uC870: 60\uCD08 \uC774\uC0C1 \uBA38\uBB34\uB974\uBA74
    \uBB38\uC11C\uC758 \uB0A8\uC740 \uAE38\uC774\uAC00 \uC904\uC5B4\uB4E4 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C169\uC870: \uC904\uC5B4\uB4E0 \uBB38\uC11C\uC758
    \uB0B4\uC6A9\uC740 \uC911\uC694\uD558\uC9C0 \uC54A\uC740 \uAC83\uC73C\uB85C \uAC04\uC8FC\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C170\uC870: \uC911\uC694\uD558\uC9C0
    \uC54A\uC740 \uB0B4\uC6A9\uC774\uB77C\uACE0 \uD574\uC11C \uC77D\uC9C0 \uC54A\uC544\uB3C4
    \uB41C\uB2E4\uB294 \uB73B\uC740 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C171\uC870:
    \uC2DC\uAC04 \uAE30\uBC18 \uD78C\uD2B8\uB294 \uC790\uB3D9\uC73C\uB85C \uC801\uC6A9\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C172\uC870: \uD78C\uD2B8 \uC0AC\uC6A9
    \uC5EC\uBD80\uB294 \uBCC4\uB3C4\uB85C \uAE30\uB85D\uB418\uC9C0 \uC54A\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C173\uC870: \uD78C\uD2B8\uB97C \uBC1B\uC740
    \uC0AC\uC6A9\uC790\uAC00 \uBD88\uC774\uC775\uC744 \uBC1B\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C174\uC870:
    \uD78C\uD2B8\uB97C \uBC1B\uC9C0 \uC54A\uC740 \uC0AC\uC6A9\uC790\uAC00 \uBCF4\uC0C1\uC744
    \uBC1B\uB294 \uAC83\uB3C4 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C175\uC870: \uAC80\uC0AC\uC758
    \uBAA9\uC801\uC740 \uD1B5\uACFC \uC5EC\uBD80 \uD655\uC778\uC5D0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C176\uC870:
    \uAC80\uC0AC\uC758 \uBAA9\uC801\uC774 \uC815\uB9D0 \uADF8\uAC83\uBFD0\uC778\uC9C0\uB294
    \uC54C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C177\uC870: \uC0AC\uC6A9\uC790\uC758
    \uC2DC\uC120\uC740 \uC2DC\uC2A4\uD15C\uC774 \uC9C1\uC811 \uCD94\uC801\uD558\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C178\uC870: \uADF8\uB7EC\uB098
    \uC0AC\uC6A9\uC790\uC758 \uCEE4\uC11C \uC704\uCE58\uB294 \uCD94\uC801\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C179\uC870: \uCEE4\uC11C \uC704\uCE58\uB294
    \uBB38\uC11C \uD0D0\uC0C9 \uD328\uD134 \uBD84\uC11D\uC5D0 \uC0AC\uC6A9\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C180\uC870: \uD0D0\uC0C9 \uD328\uD134
    \uBD84\uC11D \uACB0\uACFC\uB294 \uD654\uBA74\uC5D0 \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C181\uC870: \uBB38\uC11C \uB05D\uC758
    \uBC84\uD2BC\uC740 \uD55C \uBC88\uB9CC \uB3C4\uB9DD\uAC00\uB3C4\uB85D \uC124\uACC4\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C182\uC870: \uD55C \uBC88 \uB3C4\uB9DD\uAC04
    \uBC84\uD2BC\uC740 \uB450 \uBC88\uC9F8\uC5D0\uB294 \uC815\uC0C1\uC801\uC73C\uB85C
    \uC791\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C183\uC870: \uC815\uC0C1\uC801\uC73C\uB85C
    \uC791\uB3D9\uD558\uC9C0 \uC54A\uC744 \uACBD\uC6B0 \uC7AC\uC2DC\uB3C4\uD558\uC2ED\uC2DC\uC624.\r\n\uC81C184\uC870:
    \uC7AC\uC2DC\uB3C4 \uD69F\uC218\uC5D0\uB294 \uBCC4\uB3C4\uC758 \uC81C\uD55C\uC774
    \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C185\uC870: \uC0AC\uC6A9\uC790\uB294 \uBB38\uC11C
    \uC911\uAC04\uC5D0\uC11C \uAC8C\uC784\uC744 \uC885\uB8CC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C186\uC870:
    \uAC8C\uC784\uC744 \uC885\uB8CC\uD558\uBA74 \uD604\uC7AC \uC9C4\uD589 \uC0C1\uD0DC\uAC00
    \uC800\uC7A5\uB418\uC9C0 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C187\uC870:
    \uC800\uC7A5 \uC5EC\uBD80\uB294 \uBCC4\uB3C4\uC758 \uC54C\uB9BC\uC73C\uB85C \uC81C\uACF5\uB418\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C188\uC870: \uB2E4\uC2DC
    \uC2E4\uD589\uD558\uBA74 \uC57D\uAD00\uC740 \uCC98\uC74C\uBD80\uD130 \uD45C\uC2DC\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C189\uC870: \uCC98\uC74C\uBD80\uD130
    \uB2E4\uC2DC \uC77D\uC5B4\uC57C \uD560 \uC758\uBB34\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C190\uC870:
    \uB2E8, \uB2E4\uC2DC \uB05D\uAE4C\uC9C0 \uB0B4\uB824\uAC00\uC57C \uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C191\uC870: \uC2DC\uC2A4\uD15C\uC740 \uBE60\uB978
    \uC9C4\uD589\uC744 \uBC29\uD574\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C192\uC870:
    \uB2E4\uB9CC \uC77C\uBD80 \uC7A5\uCE58\uB294 \uBE60\uB978 \uC9C4\uD589\uC744
    \uC5B4\uB835\uAC8C \uB9CC\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C193\uC870:
    \uBB38\uC11C \uC778\uD130\uD398\uC774\uC2A4\uB294 \uC2E4\uC81C \uC6B4\uC601\uCCB4\uC81C
    \uC57D\uAD00\uACFC \uBB34\uAD00\uD569\uB2C8\uB2E4.\r\n\uC81C194\uC870: \uBB38\uC11C
    \uB0B4\uC6A9 \uC5ED\uC2DC \uBC95\uC801 \uD6A8\uB825\uC744 \uAC00\uC9C0\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C195\uC870: \uB2E8, \uAC8C\uC784 \uC138\uACC4
    \uB0B4\uBD80\uC5D0\uC11C\uB294 \uD6A8\uB825\uC774 \uC788\uB294 \uAC83\uCC98\uB7FC
    \uCDE8\uAE09\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C196\uC870: \uAC8C\uC784
    \uC138\uACC4\uC758 \uADDC\uCE59\uC740 \uC2DC\uC2A4\uD15C\uC5D0 \uC758\uD574 \uBCC0\uACBD\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C197\uC870: \uBCC0\uACBD\uB41C \uADDC\uCE59\uC740
    \uC989\uC2DC \uC801\uC6A9\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C198\uC870:
    \uC0AC\uC6A9\uC790\uB294 \uBCC0\uACBD \uB0B4\uC6A9\uC744 \uBCC4\uB3C4\uB85C \uD1B5\uC9C0\uBC1B\uC9C0
    \uBABB\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C199\uC870: \uD1B5\uC9C0\uBC1B\uC9C0
    \uBABB\uD55C \uBCC0\uACBD\uC5D0\uB3C4 \uC801\uC751\uD574\uC57C \uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C200\uC870: \uC801\uC751 \uB2A5\uB825\uC740
    \uC774\uD6C4 \uAC80\uC0AC\uC5D0 \uC601\uD5A5\uC744 \uC8FC\uC9C0 \uC54A\uC744
    \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C201\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uBB38\uC11C\uC758 \uAC00\uB3C5\uC131\uC744 \uC720\uC9C0\uD558\uB3C4\uB85D \uB178\uB825\uD569\uB2C8\uB2E4.\r\n\uC81C202\uC870:
    \uAE00\uC790\uAC00 \uC791\uC544\uC9C8 \uACBD\uC6B0 \uD655\uB300 \uAE30\uB2A5\uC740
    \uC81C\uACF5\uB418\uC9C0 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C203\uC870:
    \uAE00\uC790\uAC00 \uCEE4\uC9C8 \uACBD\uC6B0 \uB808\uC774\uC544\uC6C3\uC774 \uBCC0\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C204\uC870: \uB808\uC774\uC544\uC6C3
    \uBCC0\uD654\uB294 \uC624\uB958\uAC00 \uC544\uB2D0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C205\uC870:
    \uBB38\uC7A5 \uAC04\uACA9\uC740 \uC784\uC758\uB85C \uC870\uC815\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C206\uC870: \uBB38\uB2E8 \uAC04\uACA9\uB3C4
    \uC784\uC758\uB85C \uC870\uC815\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C207\uC870:
    \uC77C\uBD80 \uC870\uD56D\uC740 \uD55C \uC904\uB85C \uD45C\uC2DC\uB418\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C208\uC870: \uC904\uBC14\uAFC8
    \uC704\uCE58\uB294 \uC758\uBBF8\uC5D0 \uC601\uD5A5\uC744 \uC8FC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C209\uC870:
    \uBB38\uC11C\uC758 \uBC30\uACBD\uC740 \uAC80\uC740\uC0C9\uC744 \uAE30\uBCF8\uC73C\uB85C
    \uD569\uB2C8\uB2E4.\r\n\uC81C210\uC870: \uBC30\uACBD\uC0C9 \uBCC0\uD654\uB294
    \uC2DC\uC2A4\uD15C \uC0C1\uD0DC\uB97C \uB098\uD0C0\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C211\uC870:
    \uBBFC\uD2B8\uC0C9 \uAC15\uC870\uB294 \uC815\uC0C1 \uC0C1\uD0DC\uB97C \uC758\uBBF8\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C212\uC870: \uBD89\uC740\uC0C9 \uAC15\uC870\uB294
    \uACBD\uACE0 \uC0C1\uD0DC\uB97C \uC758\uBBF8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C213\uC870:
    \uD770\uC0C9 \uD14D\uC2A4\uD2B8\uB294 \uAE30\uBCF8 \uC815\uBCF4\uB85C \uCDE8\uAE09\uB429\uB2C8\uB2E4.\r\n\uC81C214\uC870:
    \uD68C\uC0C9 \uD14D\uC2A4\uD2B8\uB294 \uC911\uC694\uB3C4\uAC00 \uB0AE\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C215\uC870: \uC911\uC694\uB3C4\uAC00 \uB0AE\uC544\uB3C4
    \uC77D\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C216\uC870: \uC77D\uC9C0
    \uC54A\uC544\uB3C4 \uC9C4\uD589\uC740 \uAC00\uB2A5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C217\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uC0AC\uC6A9\uC790\uC758 \uB3C5\uD574 \uC18D\uB3C4\uB97C
    \uD3C9\uAC00\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C218\uC870: \uB2E8,
    \uBA38\uBB38 \uC2DC\uAC04\uC740 \uAE30\uB85D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C219\uC870:
    \uBA38\uBB38 \uC2DC\uAC04\uC774 \uAE38\uC5B4\uB3C4 \uC2E4\uD328\uB85C \uAC04\uC8FC\uB418\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C220\uC870: \uBA38\uBB38 \uC2DC\uAC04\uC774
    \uC9E7\uC544\uB3C4 \uC131\uACF5\uC73C\uB85C \uAC04\uC8FC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C221\uC870:
    \uBB38\uC11C \uB9C8\uC9C0\uB9C9\uC5D0 \uB3C4\uB2EC\uD558\uBA74 \uC0C1\uD0DC \uD45C\uC2DC\uAC00
    \uBCC0\uACBD\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C222\uC870: \uC0C1\uD0DC
    \uD45C\uC2DC\uB294 \uD604\uC7AC \uC9C4\uD589 \uC0C1\uD669\uC744 \uC694\uC57D\uD569\uB2C8\uB2E4.\r\n\uC81C223\uC870:
    \uC0C1\uD0DC \uD45C\uC2DC\uAC00 \uC798\uBABB\uB41C \uC815\uBCF4\uB97C \uBCF4\uC5EC\uC904
    \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C224\uC870: \uC798\uBABB\uB41C
    \uC0C1\uD0DC \uD45C\uC2DC\uB294 \uC2DC\uC2A4\uD15C \uC5F0\uCD9C\uC77C \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C225\uC870: \uC5F0\uCD9C\uACFC \uC2E4\uC81C
    \uC624\uB958\uB97C \uAD6C\uBD84\uD560 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C226\uC870:
    \uAD6C\uBD84\uD558\uB824\uACE0 \uC2DC\uB3C4\uD574\uB3C4 \uBB34\uBC29\uD569\uB2C8\uB2E4.\r\n\uC81C227\uC870:
    \uC77C\uBD80 \uD14D\uC2A4\uD2B8\uB294 \uC0AC\uC6A9\uC790\uB97C \uD63C\uB780\uC2A4\uB7FD\uAC8C
    \uD558\uAE30 \uC704\uD574 \uC791\uC131\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C228\uC870:
    \uD63C\uB780\uC740 \uBCF8 \uAC80\uC0AC\uC758 \uD544\uC218 \uC694\uC18C\uB294
    \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C229\uC870: \uD63C\uB780\uC774 \uC5C6\uB354\uB77C\uB3C4
    \uAC80\uC0AC\uB294 \uC815\uC0C1\uC801\uC73C\uB85C \uC9C4\uD589\uB429\uB2C8\uB2E4.\r\n\uC81C230\uC870:
    \uD63C\uB780\uC774 \uC788\uC5B4\uB3C4 \uAC80\uC0AC\uB294 \uC815\uC0C1\uC801\uC73C\uB85C
    \uC9C4\uD589\uB429\uB2C8\uB2E4.\r\n\uC81C231\uC870: \uC0AC\uC6A9\uC790\uB294
    \uBB38\uC11C \uC18D \uB18D\uB2F4\uC744 \uC9C4\uC9C0\uD558\uAC8C \uBC1B\uC544\uB4E4\uC774\uC9C0
    \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4.\r\n\uC81C232\uC870: \uC9C4\uC9C0\uD55C
    \uBB38\uAD6C\uB97C \uB18D\uB2F4\uC73C\uB85C \uBC1B\uC544\uB4E4\uC5EC\uB3C4 \uB429\uB2C8\uB2E4.\r\n\uC81C233\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uD574\uC11D \uBC29\uC2DD\uC5D0 \uAD00\uC5EC\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C234\uC870: \uB2E4\uB9CC \uC120\uD0DD \uACB0\uACFC\uB294
    \uAE30\uB85D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C235\uC870: \uAE30\uB85D\uB41C
    \uACB0\uACFC\uB294 \uB2E4\uC74C \uCC55\uD130\uC5D0\uC11C \uC0AC\uC6A9\uB418\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C236\uC870: \uC0AC\uC6A9\uB418\uC9C0
    \uC54A\uB294 \uB370\uC774\uD130\uB3C4 \uC0AD\uC81C\uB418\uC9C0 \uC54A\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C237\uC870: \uC0AD\uC81C\uB418\uC9C0 \uC54A\uC740
    \uB370\uC774\uD130\uB294 \uD654\uBA74\uC5D0 \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C238\uC870:
    \uD45C\uC2DC\uB418\uC9C0 \uC54A\uB294 \uB370\uC774\uD130\uC758 \uC874\uC7AC\uB97C
    \uAC71\uC815\uD560 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C239\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uC0AC\uC6A9\uC790\uC5D0\uAC8C \uBD88\uD544\uC694\uD55C
    \uAC71\uC815\uC744 \uAD8C\uC7A5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C240\uC870:
    \uB300\uC2E0 \uACC4\uC18D \uC9C4\uD589\uD558\uB294 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4.\r\n\uC81C241\uC870:
    \uACC4\uC18D \uC9C4\uD589 \uBC84\uD2BC\uC774 \uB098\uD0C0\uB0A0 \uB54C\uAE4C\uC9C0
    \uC2A4\uD06C\uB864\uD558\uC2ED\uC2DC\uC624.\r\n\uC81C242\uC870: \uACC4\uC18D
    \uC9C4\uD589 \uBC84\uD2BC\uC774 \uC544\uB2C8\uB77C \uC2DC\uC791 \uBC84\uD2BC\uC774
    \uB098\uD0C0\uB0A0 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C243\uC870:
    \uBC84\uD2BC \uBB38\uAD6C\uB294 \uC57D\uAC04 \uB2EC\uB77C\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C244\uC870:
    \uBB38\uAD6C\uAC00 \uB2EC\uB77C\uB3C4 \uAE30\uB2A5\uC740 \uB3D9\uC77C\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C245\uC870: \uAE30\uB2A5\uC774 \uB3D9\uC77C\uD574\uB3C4
    \uACB0\uACFC\uB294 \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C246\uC870:
    \uACB0\uACFC\uAC00 \uB2EC\uB77C\uB3C4 \uAC80\uC0AC\uB294 \uC131\uACF5\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C247\uC870: \uC131\uACF5 \uC5EC\uBD80\uB294
    \uC2DC\uC2A4\uD15C\uC774 \uCD5C\uC885 \uD310\uB2E8\uD569\uB2C8\uB2E4.\r\n\uC81C248\uC870:
    \uD310\uB2E8 \uAE30\uC900\uC740 \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C249\uC870: \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC740
    \uAE30\uC900\uC744 \uCD94\uCE21\uD560 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C250\uC870:
    \uCD94\uCE21 \uC790\uCCB4\uB294 \uC790\uC720\uC785\uB2C8\uB2E4.\r\n\uC81C251\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uC0AC\uC6A9\uC790\uC758 \uC120\uD0DD\uC744 \uAC15\uC694\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C252\uC870: \uB2E4\uB9CC \uB2E4\uC74C \uB2E8\uACC4\uB85C
    \uAC00\uB824\uBA74 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC57C \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C253\uC870:
    \uBC84\uD2BC\uC744 \uB204\uB974\uC9C0 \uC54A\uC73C\uBA74 \uD604\uC7AC \uD654\uBA74\uC5D0
    \uBA38\uBB34\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C254\uC870: \uD604\uC7AC
    \uD654\uBA74\uC5D0 \uC624\uB798 \uBA38\uBB3C\uB7EC\uB3C4 \uD398\uB110\uD2F0\uB294
    \uC5C6\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C255\uC870: \uC77C\uBD80
    \uD6A8\uACFC\uC74C\uC740 \uC9C4\uD589 \uC0C1\uD0DC\uB97C \uC54C\uB824\uC904 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C256\uC870: \uD6A8\uACFC\uC74C\uC774 \uB4E4\uB9AC\uC9C0
    \uC54A\uC544\uB3C4 \uC9C4\uD589 \uC0C1\uD0DC\uB294 \uC720\uC9C0\uB429\uB2C8\uB2E4.\r\n\uC81C257\uC870:
    \uC74C\uC18C\uAC70 \uC0C1\uD0DC\uC5D0\uC11C\uB3C4 \uAC80\uC0AC\uB294 \uC218\uD589\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C258\uC870: \uC2DC\uAC01 \uD6A8\uACFC\uAC00
    \uAEBC\uC838 \uC788\uC5B4\uB3C4 \uAC80\uC0AC\uB294 \uC218\uD589\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C259\uC870: \uC77C\uBD80 \uC5F0\uCD9C\uC740
    \uD504\uB808\uC784 \uC18D\uB3C4\uC5D0 \uB530\uB77C \uB2E4\uB974\uAC8C \uBCF4\uC77C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C260\uC870: \uD504\uB808\uC784 \uC18D\uB3C4
    \uCC28\uC774\uB294 \uD310\uC815\uC5D0 \uC601\uD5A5\uC744 \uC8FC\uC9C0 \uC54A\uB3C4\uB85D
    \uC124\uACC4\uB429\uB2C8\uB2E4.\r\n\uC81C261\uC870: \uC124\uACC4 \uC758\uB3C4\uC640
    \uC2E4\uC81C \uB3D9\uC791\uC740 \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C262\uC870:
    \uB2E4\uB97C \uACBD\uC6B0 \uC2DC\uC2A4\uD15C\uC740 \uAC00\uB2A5\uD55C \uBC94\uC704\uC5D0\uC11C
    \uACC4\uC18D \uC9C4\uD589\uD569\uB2C8\uB2E4.\r\n\uC81C263\uC870: \uBB38\uC11C
    \uC2A4\uD06C\uB864\uC740 \uB9C8\uC6B0\uC2A4 \uD720\uC744 \uAE30\uBCF8 \uC785\uB825\uC73C\uB85C
    \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\r\n\uC81C264\uC870: \uC2A4\uD06C\uB864\uBC14
    \uB4DC\uB798\uADF8\uB3C4 \uD5C8\uC6A9\uB429\uB2C8\uB2E4.\r\n\uC81C265\uC870:
    \uD398\uC774\uC9C0 \uC5C5\xB7\uB2E4\uC6B4 \uD0A4\uB294 \uC9C0\uC6D0\uB418\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C266\uC870: \uD0A4\uBCF4\uB4DC
    \uC785\uB825\uC774 \uC5C6\uC5B4\uB3C4 \uAC80\uC0AC\uB294 \uC644\uB8CC\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C267\uC870: \uB9C8\uC6B0\uC2A4 \uC785\uB825\uB9CC\uC73C\uB85C
    \uC804\uCCB4 \uACFC\uC815\uC744 \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C268\uC870:
    \uB9C8\uC6B0\uC2A4\uAC00 \uC5F0\uACB0\uB418\uC9C0 \uC54A\uC740 \uACBD\uC6B0 \uC9C4\uD589\uC774
    \uC5B4\uB824\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C269\uC870: \uD130\uCE58
    \uC785\uB825\uC740 \uBCC4\uB3C4\uB85C \uC9C0\uC6D0\uB418\uC9C0 \uC54A\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C270\uC870: \uC9C0\uC6D0\uB418\uC9C0 \uC54A\uB294
    \uC785\uB825 \uC7A5\uCE58\uB294 \uC624\uB958 \uC6D0\uC778\uC774 \uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C271\uC870: \uC624\uB958 \uC6D0\uC778\uC774
    \uC0AC\uC6A9\uC790\uC5D0\uAC8C \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C272\uC870:
    \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC740 \uC624\uB958\uB294 \uC790\uB3D9\uC73C\uB85C
    \uBCF5\uAD6C\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C273\uC870: \uC790\uB3D9
    \uBCF5\uAD6C \uACFC\uC815\uC5D0\uC11C \uD654\uBA74\uC774 \uC7A0\uC2DC \uBA48\uCD9C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C274\uC870: \uBA48\uCDA4\uC774 1\uCD08
    \uC774\uB0B4\uB77C\uBA74 \uC815\uC0C1 \uC5F0\uCD9C\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C275\uC870:
    1\uCD08\uB97C \uB118\uACA8\uB3C4 \uC815\uC0C1\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C276\uC870:
    \uC815\uC0C1 \uC5EC\uBD80\uB294 \uC2DC\uC2A4\uD15C \uB85C\uADF8\uC5D0 \uAE30\uB85D\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C277\uC870: \uB85C\uADF8\uB294 \uC0AC\uC6A9\uC790\uC5D0\uAC8C
    \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C278\uC870: \uB85C\uADF8
    \uACF5\uAC1C\uB97C \uC694\uCCAD\uD560 \uC218 \uC788\uB294 \uAE30\uB2A5\uC740
    \uC81C\uACF5\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C279\uC870: \uC0AC\uC6A9\uC790\uB294
    \uAC8C\uC784 \uD654\uBA74\uB9CC\uC73C\uB85C \uC9C4\uD589 \uC0C1\uD0DC\uB97C \uD310\uB2E8\uD574\uC57C
    \uD569\uB2C8\uB2E4.\r\n\uC81C280\uC870: \uC9C4\uD589 \uC0C1\uD0DC \uD310\uB2E8\uC774
    \uC5B4\uB824\uC6B8 \uACBD\uC6B0 \uD78C\uD2B8\uB97C \uCC38\uACE0\uD558\uC2ED\uC2DC\uC624.\r\n\uC81C281\uC870:
    \uD78C\uD2B8\uB294 \uD654\uBA74 \uD558\uB2E8\uC5D0\uC11C \uD655\uC778\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C282\uC870: \uD78C\uD2B8 \uD45C\uC2DC\uAC00
    \uBE44\uD65C\uC131\uD654\uB418\uC5B4 \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C283\uC870:
    \uC870\uAC74\uC744 \uCDA9\uC871\uD558\uBA74 \uD78C\uD2B8 \uD45C\uC2DC\uAC00 \uD65C\uC131\uD654\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C284\uC870: \uD78C\uD2B8\uAC00 \uD65C\uC131\uD654\uB418\uAE30
    \uC804\uC5D0 \uD074\uB9AC\uC5B4\uD574\uB3C4 \uBB38\uC81C\uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C285\uC870:
    \uD074\uB9AC\uC5B4 \uD6C4 \uB0A8\uC740 \uD78C\uD2B8\uB294 \uC0AC\uC6A9\uB418\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C286\uC870: \uC2E4\uD328 \uD69F\uC218\uB294
    \uD604\uC7AC \uBBF8\uB2C8\uAC8C\uC784\uC5D0\uC11C\uB9CC \uC9D1\uACC4\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C287\uC870: \uC774\uC804 \uC2E4\uD328 \uD69F\uC218\uB294
    \uB2E4\uC74C \uBBF8\uB2C8\uAC8C\uC784\uC73C\uB85C \uC804\uB2EC\uB418\uC9C0 \uC54A\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C288\uC870: \uCC55\uD130 \uC804\uCCB4
    \uC2E4\uD328 \uD69F\uC218\uB294 \uBCC4\uB3C4\uB85C \uC800\uC7A5\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C289\uC870: \uC800\uC7A5\uB41C \uC2E4\uD328
    \uD69F\uC218\uB294 \uC5D4\uB529\uC5D0 \uC601\uD5A5\uC744 \uC8FC\uC9C0 \uC54A\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C290\uC870: \uC5D4\uB529 \uC870\uAC74\uC740
    \uC2E4\uD328 \uD69F\uC218\uC640 \uBB34\uAD00\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C291\uC870:
    \uC5D4\uB529 \uC870\uAC74\uC740 \uC544\uC9C1 \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\r\n\uC81C292\uC870:
    \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC740 \uC870\uAC74\uC744 \uCC3E\uC73C\uB824 \uD558\uC9C0
    \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4.\r\n\uC81C293\uC870: \uCC3E\uC73C\uB824
    \uD574\uB3C4 \uC2DC\uC2A4\uD15C\uC740 \uB9C9\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C294\uC870:
    \uC228\uACA8\uC9C4 \uC0C1\uD638\uC791\uC6A9\uC774 \uC874\uC7AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C295\uC870:
    \uC228\uACA8\uC9C4 \uC0C1\uD638\uC791\uC6A9\uC774 \uC5C6\uC5B4\uB3C4 \uC774\uC0C1\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C296\uC870: \uC57D\uAD00 \uBB38\uC11C \uC790\uCCB4\uAC00
    \uD558\uB098\uC758 \uD37C\uC990\uB85C \uAC04\uC8FC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C297\uC870:
    \uD37C\uC990\uC758 \uD575\uC2EC\uC740 \uB05D\uAE4C\uC9C0 \uC774\uB3D9\uD558\uB294
    \uAC83\uC785\uB2C8\uB2E4.\r\n\uC81C298\uC870: \uBCF5\uC7A1\uD558\uAC8C \uC0DD\uAC01\uD558\uC9C0
    \uC54A\uB294 \uAC83\uC774 \uB3C4\uC6C0\uC774 \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C299\uC870:
    \uB108\uBB34 \uB2E8\uC21C\uD558\uAC8C \uC0DD\uAC01\uD574\uB3C4 \uB3C4\uC6C0\uC774
    \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C300\uC870: \uAC00\uC7A5 \uC911\uC694\uD55C
    \uAC83\uC740 \uB2E4\uC2DC \uC544\uB798\uB85C \uB0B4\uB824\uAC00\uB294 \uAC83\uC785\uB2C8\uB2E4.\r\n\r\n\uC81C301\uC870:
    \uCCAB \uBC88\uC9F8 \uCD08\uAE30\uD654 \uC774\uD6C4 \uC2DC\uC2A4\uD15C\uC740
    \uC0AC\uC6A9\uC790\uAC00 \uBB38\uC11C \uAD6C\uC870\uB97C \uC774\uD574\uD55C \uAC83\uC73C\uB85C
    \uAC04\uC8FC\uD569\uB2C8\uB2E4.\r\n\uC81C302\uC870: \uC774\uD574 \uC5EC\uBD80\uC640
    \uAD00\uACC4\uC5C6\uC774 \uB450 \uBC88\uC9F8 \uD0D0\uC0C9\uC740 \uACC4\uC18D\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C303\uC870: \uB450 \uBC88\uC9F8 \uD0D0\uC0C9\uC5D0\uC11C\uB294
    \uC77C\uBD80 \uBC29\uD574 \uC694\uC18C\uAC00 \uC644\uD654\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C304\uC870:
    \uC644\uD654\uB41C \uBC29\uD574 \uC694\uC18C\uB294 \uC0AC\uC6A9\uC790\uC5D0\uAC8C
    \uBCC4\uB3C4\uB85C \uC548\uB0B4\uB418\uC9C0 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C305\uC870:
    \uBB38\uC11C \uAE38\uC774\uB294 \uCCAB \uBC88\uC9F8 \uD0D0\uC0C9\uACFC \uB2E4\uB974\uAC8C
    \uB290\uAEF4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C306\uC870: \uC2E4\uC81C
    \uBB38\uC11C \uAE38\uC774\uAC00 \uBCC0\uACBD\uB418\uC5C8\uB294\uC9C0\uB294 \uD655\uC778\uD560
    \uD544\uC694\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C307\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uC0AC\uC6A9\uC790\uC758 \uC2A4\uD06C\uB864 \uBC29\uD5A5\uC744 \uACC4\uC18D \uD655\uC778\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C308\uC870: \uC544\uB798 \uBC29\uD5A5
    \uC785\uB825\uC740 \uC9C4\uD589 \uC758\uC0AC\uB85C \uD574\uC11D\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C309\uC870: \uC704 \uBC29\uD5A5 \uC785\uB825\uC740
    \uC7AC\uD655\uC778 \uC758\uC0AC\uB85C \uD574\uC11D\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C310\uC870:
    \uC785\uB825\uC774 \uC5C6\uB294 \uC0C1\uD0DC\uB294 \uD310\uB2E8 \uBCF4\uB958\uB85C
    \uAE30\uB85D\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C311\uC870: \uD310\uB2E8
    \uBCF4\uB958 \uC0C1\uD0DC\uC5D0\uC11C\uB3C4 \uC2DC\uAC04\uC740 \uACC4\uC18D \uD750\uB97C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C312\uC870: \uC2DC\uAC04 \uACBD\uACFC\uB294
    \uBB38\uC11C\uC758 \uD6A8\uB825\uC5D0 \uC601\uD5A5\uC744 \uC8FC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C313\uC870:
    \uC77C\uC815 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC2DC\uC2A4\uD15C\uC740 \uCD94\uAC00
    \uC548\uB0B4\uB97C \uC81C\uACF5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C314\uC870:
    \uCD94\uAC00 \uC548\uB0B4\uB294 \uC0AC\uC6A9\uC790\uC758 \uC694\uCCAD \uC5C6\uC774
    \uD45C\uC2DC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C315\uC870: \uC548\uB0B4\uB97C
    \uBB34\uC2DC\uD574\uB3C4 \uC9C4\uD589\uC5D0\uB294 \uBB38\uC81C\uAC00 \uC5C6\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C316\uC870: \uC548\uB0B4\uB97C \uC77D\uB294
    \uB3D9\uC548 \uBB38\uC11C\uB294 \uACC4\uC18D \uD604\uC7AC \uC704\uCE58\uB97C
    \uC720\uC9C0\uD569\uB2C8\uB2E4.\r\n\uC81C317\uC870: \uD604\uC7AC \uC704\uCE58\uB294
    \uC5B8\uC81C\uB4E0 \uCD08\uAE30\uD654\uB420 \uAC00\uB2A5\uC131\uC774 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C318\uC870:
    \uB2E4\uB9CC \uC774\uBBF8 \uD55C \uBC88 \uCD08\uAE30\uD654\uB41C \uACBD\uC6B0
    \uAC19\uC740 \uC7A5\uB09C\uC740 \uBC18\uBCF5\uB418\uC9C0 \uC54A\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C319\uC870: \uBC18\uBCF5\uB418\uC9C0 \uC54A\uB294\uB2E4\uACE0
    \uD655\uC815\uC801\uC73C\uB85C \uB9D0\uD560 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C320\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uD655\uC815\uC801\uC778 \uD45C\uD604\uC758 \uC0AC\uC6A9\uC744
    \uC790\uC81C\uD569\uB2C8\uB2E4.\r\n\uC81C321\uC870: \uBC84\uD2BC \uC704\uC5D0
    \uCEE4\uC11C\uAC00 \uC811\uADFC\uD558\uBA74 \uC2DC\uC2A4\uD15C\uC740 \uAD00\uC2EC
    \uC0C1\uD0DC\uB85C \uC804\uD658\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C322\uC870:
    \uAD00\uC2EC \uC0C1\uD0DC\uB294 \uD074\uB9AD \uC0C1\uD0DC\uC640 \uB2E4\uB985\uB2C8\uB2E4.\r\n\uC81C323\uC870:
    \uD074\uB9AD \uC0C1\uD0DC\uB294 \uC2E4\uC81C \uBC84\uD2BC \uC785\uB825\uC774
    \uBC1C\uC0DD\uD588\uC744 \uB54C \uAE30\uB85D\uB429\uB2C8\uB2E4.\r\n\uC81C324\uC870:
    \uCCAB \uBC88\uC9F8 \uAD00\uC2EC \uC0C1\uD0DC\uB294 \uBC84\uD2BC\uC758 \uD68C\uD53C
    \uD589\uB3D9\uC744 \uBC1C\uC0DD\uC2DC\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C325\uC870:
    \uD68C\uD53C \uD589\uB3D9\uC740 \uBB38\uC11C \uC704\uCE58 \uCD08\uAE30\uD654\uB85C
    \uD45C\uD604\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C326\uC870: \uBB38\uC11C
    \uC704\uCE58\uAC00 \uCD08\uAE30\uD654\uB418\uBA74 \uC0AC\uC6A9\uC790\uB294 \uB2E4\uC2DC
    \uC544\uB798\uB85C \uC774\uB3D9\uD574\uC57C \uD569\uB2C8\uB2E4.\r\n\uC81C327\uC870:
    \uB2E4\uC2DC \uC774\uB3D9\uD558\uB294 \uB3D9\uC548 \uC774\uC804 \uC9C4\uD589
    \uAE30\uB85D\uC740 \uC720\uC9C0\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C328\uC870:
    \uC774\uC804 \uC9C4\uD589 \uAE30\uB85D\uC740 \uD654\uBA74\uC5D0 \uD45C\uC2DC\uB418\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C329\uC870: \uB450 \uBC88\uC9F8
    \uD558\uB2E8 \uB3C4\uB2EC\uC740 \uD655\uC778 \uC0C1\uD0DC\uB85C \uAE30\uB85D\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C330\uC870: \uD655\uC778 \uC0C1\uD0DC\uC5D0\uC11C\uB294
    \uC2DC\uC791 \uBC84\uD2BC\uC774 \uC815\uC0C1\uC801\uC73C\uB85C \uC791\uB3D9\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C331\uC870: \uC815\uC0C1\uC801\uC73C\uB85C
    \uC791\uB3D9\uD558\uB294 \uBC84\uD2BC\uC740 \uC624\uD788\uB824 \uB0AF\uC124\uAC8C
    \uB290\uAEF4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C332\uC870: \uADF8
    \uB290\uB08C\uC740 \uAC80\uC0AC \uACB0\uACFC\uC5D0 \uBC18\uC601\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C333\uC870:
    \uBC84\uD2BC \uD074\uB9AD \uD6C4 \uC2DC\uC2A4\uD15C\uC740 \uC7A0\uC2DC \uC751\uB2F5\uD558\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C334\uC870: \uC7A0\uC2DC
    \uB3D9\uC548\uC758 \uBB34\uC751\uB2F5\uC740 \uC131\uACF5 \uC5F0\uCD9C\uC758 \uC77C\uBD80\uC77C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C335\uC870: \uC131\uACF5 \uC5EC\uBD80\uB294
    \uD654\uBA74\uC758 \uC0C1\uD0DC \uBB38\uAD6C\uB85C \uD655\uC778\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C336\uC870: \uC0C1\uD0DC \uBB38\uAD6C\uAC00
    \uD45C\uC2DC\uB418\uAE30 \uC804\uC5D0 \uB2E4\uC74C \uD654\uBA74\uC73C\uB85C \uB118\uC5B4\uAC08
    \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C337\uC870: \uD654\uBA74 \uC804\uD658\uC740
    \uC0AC\uC6A9\uC790 \uC785\uB825\uC744 \uCD94\uAC00\uB85C \uC694\uAD6C\uD558\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C338\uC870: \uC804\uD658
    \uC911\uC5D0\uB294 \uD604\uC7AC \uBB38\uC11C \uC785\uB825\uC774 \uBE44\uD65C\uC131\uD654\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C339\uC870: \uBE44\uD65C\uC131\uD654\uB41C
    \uC785\uB825\uC740 \uC2E4\uD328\uB85C \uAE30\uB85D\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C340\uC870:
    \uC131\uACF5 \uC774\uD6C4\uC758 \uCD94\uAC00 \uC2A4\uD06C\uB864 \uC785\uB825\uC740
    \uBB34\uC2DC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C341\uC870: \uC131\uACF5
    \uC774\uD6C4\uC758 \uCD94\uAC00 \uD074\uB9AD \uC785\uB825\uB3C4 \uBB34\uC2DC\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C342\uC870: \uAC80\uC0AC \uC644\uB8CC
    \uC2DC \uC900\uBE44\uB3C4\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4.\r\n\uC81C343\uC870:
    \uC900\uBE44\uB3C4 \uC99D\uAC00\uB294 \uAC8C\uC784 \uC2E4\uD589\uC5D0 \uAC00\uAE4C\uC6CC\uC84C\uC74C\uC744
    \uC758\uBBF8\uD569\uB2C8\uB2E4.\r\n\uC81C344\uC870: \uAC8C\uC784 \uC2E4\uD589\uC5D0
    \uAC00\uAE4C\uC6CC\uC84C\uB2E4\uB294 \uAC83\uC774 \uC2E4\uC81C \uC2DC\uC791 \uC2DC\uC810\uC744
    \uC758\uBBF8\uD558\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C345\uC870:
    \uC2DC\uC791 \uC2DC\uC810\uC740 \uC2DC\uC2A4\uD15C\uC774 \uBCC4\uB3C4\uB85C \uD310\uB2E8\uD569\uB2C8\uB2E4.\r\n\uC81C346\uC870:
    \uC0AC\uC6A9\uC790\uAC00 \uC2DC\uC791 \uC2DC\uC810\uC744 \uD310\uB2E8\uD560 \uD544\uC694\uB294
    \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C347\uC870: \uD310\uB2E8\uD558\uB824\uACE0
    \uD574\uB3C4 \uC2DC\uC2A4\uD15C\uC740 \uB9C9\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C348\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uC0AC\uC6A9\uC790\uC758 \uD638\uAE30\uC2EC\uC744 \uC81C\uD55C\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C349\uC870: \uD638\uAE30\uC2EC\uC5D0 \uB300\uD55C
    \uBCF4\uC0C1\uC740 \uC81C\uACF5\uB418\uC9C0 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C350\uC870:
    \uACC4\uC18D \uC9C4\uD589\uD558\uB294 \uAC83\uC774 \uAC00\uC7A5 \uC548\uC815\uC801\uC778
    \uC120\uD0DD\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C351\uC870: \uBCF8
    \uBB38\uC11C\uC758 \uBAA8\uB4E0 \uC870\uD56D\uC740 \uAC19\uC740 \uC911\uC694\uB3C4\uB97C
    \uAC00\uC9C4 \uAC83\uC73C\uB85C \uAC04\uC8FC\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C352\uC870:
    \uC911\uC694\uB3C4\uAC00 \uB192\uC740 \uC870\uD56D\uC5D0\uB294 \uBCC4\uB3C4 \uD45C\uC2DC\uAC00
    \uC5C6\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C353\uC870: \uC911\uC694\uB3C4\uAC00
    \uB0AE\uC740 \uC870\uD56D\uB3C4 \uB3D9\uC77C\uD55C \uD615\uC2DD\uC73C\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4.\r\n\uC81C354\uC870:
    \uC0AC\uC6A9\uC790\uB294 \uC911\uC694\uB3C4\uB97C \uAD6C\uBD84\uD558\uC9C0 \uC54A\uACE0
    \uC2A4\uD06C\uB864\uD574\uB3C4 \uB429\uB2C8\uB2E4.\r\n\uC81C355\uC870: \uBB38\uC11C
    \uC911\uAC04\uC758 \uACF5\uBC31\uC740 \uC815\uC0C1\uC801\uC778 \uAD6C\uBD84 \uC601\uC5ED\uC785\uB2C8\uB2E4.\r\n\uC81C356\uC870:
    \uACF5\uBC31 \uC544\uB798\uC5D0 \uCD94\uAC00 \uBB38\uC7A5\uC774 \uC874\uC7AC\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C357\uC870: \uAD6C\uBD84\uC120\uC740
    \uBB38\uB2E8\uC758 \uB05D\uC744 \uB098\uD0C0\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C358\uC870:
    \uAD6C\uBD84\uC120\uC774 \uBB38\uC11C\uC758 \uB05D\uC744 \uC758\uBBF8\uD558\uC9C0\uB294
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C359\uC870: \uAE34 \uACF5\uBC31\uC744 \uBCF4\uACE0
    \uB05D\uC774\uB77C\uACE0 \uD310\uB2E8\uD558\uC9C0 \uB9C8\uC2ED\uC2DC\uC624.\r\n\uC81C360\uC870:
    \uC9E7\uC740 \uACF5\uBC31\uC744 \uBCF4\uACE0 \uC2DC\uC791\uC774\uB77C\uACE0 \uD310\uB2E8\uD560
    \uD544\uC694\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C361\uC870: \uBB38\uC11C
    \uC548\uC758 \uC22B\uC790\uB294 \uC870\uD56D \uBC88\uD638\uC77C \uAC00\uB2A5\uC131\uC774
    \uB192\uC2B5\uB2C8\uB2E4.\r\n\uC81C362\uC870: \uC870\uD56D \uBC88\uD638\uAC00
    \uB9CE\uB2E4\uACE0 \uD574\uC11C \uB0B4\uC6A9\uC774 \uC911\uC694\uD55C \uAC83\uC740
    \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C363\uC870: \uC870\uD56D \uBC88\uD638\uAC00
    \uC801\uB2E4\uACE0 \uD574\uC11C \uC911\uC694\uD558\uC9C0 \uC54A\uC740 \uAC83\uB3C4
    \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C364\uC870: \uC77C\uBD80 \uC870\uD56D\uC740
    \uC55E \uC870\uD56D\uACFC \uBAA8\uC21C\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C365\uC870:
    \uBAA8\uC21C\uB418\uB294 \uC870\uD56D\uC740 \uB354 \uB098\uC911\uC5D0 \uD45C\uC2DC\uB41C
    \uC870\uD56D\uC744 \uC6B0\uC120\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C366\uC870:
    \uB2E4\uB9CC \uC6B0\uC120\uC21C\uC704\uAC00 \uC2E4\uC81C\uB85C \uD544\uC694\uD55C
    \uC0C1\uD669\uC740 \uAC70\uC758 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C367\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uBAA8\uC21C\uC744 \uC624\uB958\uB85C \uBD84\uB958\uD558\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C368\uC870: \uC0AC\uC6A9\uC790\uB294
    \uBAA8\uC21C\uC744 \uD574\uACB0\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4.\r\n\uC81C369\uC870:
    \uD574\uACB0\uB418\uC9C0 \uC54A\uC740 \uBAA8\uC21C\uC740 \uADF8\uB300\uB85C \uC720\uC9C0\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C370\uC870: \uBB38\uC11C \uB0B4\uC6A9\uC740
    \uD654\uBA74 \uC804\uD658 \uC774\uD6C4 \uD6A8\uB825\uC744 \uC783\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C371\uC870: \uD6A8\uB825\uC744 \uC783\uC740
    \uC870\uD56D\uC740 \uB2E4\uC2DC \uD655\uC778\uD560 \uD544\uC694\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C372\uC870:
    \uD6A8\uB825\uC744 \uC783\uC9C0 \uC54A\uC740 \uC870\uD56D\uC774 \uC874\uC7AC\uD560
    \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C373\uC870: \uADF8 \uC870\uD56D\uC774
    \uBB34\uC5C7\uC778\uC9C0\uB294 \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C374\uC870:
    \uC0AC\uC6A9\uC790\uB294 \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC740 \uC870\uD56D\uC744
    \uCC3E\uC744 \uD544\uC694\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C375\uC870:
    \uCC3E\uC73C\uB824 \uD558\uBA74 \uC2DC\uAC04\uC774 \uB354 \uC624\uB798 \uAC78\uB9B4
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C376\uC870: \uBB38\uC11C\uB97C \uBE60\uB974\uAC8C
    \uC77D\uB294 \uD589\uC704\uB294 \uD5C8\uC6A9\uB429\uB2C8\uB2E4.\r\n\uC81C377\uC870:
    \uBB38\uC11C\uB97C \uC77D\uC9C0 \uC54A\uACE0 \uC2A4\uD06C\uB864\uD558\uB294 \uD589\uC704\uB3C4
    \uD5C8\uC6A9\uB429\uB2C8\uB2E4.\r\n\uC81C378\uC870: \uBB38\uC11C\uB97C \uC804\uD600
    \uC774\uD574\uD558\uC9C0 \uBABB\uD574\uB3C4 \uD558\uB2E8\uC5D0 \uB3C4\uB2EC\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C379\uC870: \uD558\uB2E8 \uB3C4\uB2EC
    \uC790\uCCB4\uAC00 \uBCF8 \uAC80\uC0AC\uC758 \uC8FC\uC694 \uC870\uAC74\uC785\uB2C8\uB2E4.\r\n\uC81C380\uC870:
    \uAC80\uC0AC\uC758 \uC870\uAC74\uC740 \uC57D\uAD00 \uB0B4\uC6A9\uBCF4\uB2E4 \uB2E8\uC21C\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C381\uC870: \uB2E8\uC21C\uD55C \uC870\uAC74\uC774
    \uAE34 \uBB38\uC11C \uB4A4\uC5D0 \uC228\uACA8\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C382\uC870:
    \uAE34 \uBB38\uC11C\uB294 \uC2DC\uC2A4\uD15C\uC758 \uCDE8\uD5A5\uC77C \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C383\uC870: \uC2DC\uC2A4\uD15C\uC5D0\uAC8C
    \uCDE8\uD5A5\uC774 \uC788\uB294\uC9C0\uB294 \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\r\n\uC81C384\uC870:
    \uD655\uC778\uB418\uC9C0 \uC54A\uC740 \uC0AC\uD56D\uC740 \uD655\uC778\uB418\uC9C0
    \uC54A\uC740 \uC0C1\uD0DC\uB85C \uC720\uC9C0\uB429\uB2C8\uB2E4.\r\n\uC81C385\uC870:
    \uC0AC\uC6A9\uC790\uB294 \uD655\uC778\uB418\uC9C0 \uC54A\uC740 \uC0AC\uD56D\uC5D0
    \uB3D9\uC758\uD560 \uD544\uC694\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C386\uC870:
    \uB2E4\uB9CC \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uB3D9\uC758\uD55C \uAC83\uCC98\uB7FC
    \uBCF4\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C387\uC870: \u2018\uB3D9\uC758\u2019\uB77C\uB294
    \uB2E8\uC5B4\uB294 \uAC8C\uC784 \uB0B4 \uD45C\uD604\uC73C\uB85C\uB9CC \uC0AC\uC6A9\uB429\uB2C8\uB2E4.\r\n\uC81C388\uC870:
    \uB3D9\uC758 \uBC84\uD2BC\uC740 \uC2E4\uC81C \uACC4\uC57D\uC744 \uC0DD\uC131\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C389\uC870: \uC2E4\uC81C \uACC4\uC57D\uC774
    \uC0DD\uC131\uB418\uC9C0 \uC54A\uC544\uB3C4 \uBC84\uD2BC\uC740 \uC815\uC0C1\uC801\uC73C\uB85C
    \uC791\uB3D9\uD569\uB2C8\uB2E4.\r\n\uC81C390\uC870: \uBC84\uD2BC\uC774 \uC815\uC0C1\uC801\uC73C\uB85C
    \uC791\uB3D9\uD558\uC9C0 \uC54A\uC73C\uBA74 \uB2E4\uC2DC \uC811\uADFC\uD558\uC2ED\uC2DC\uC624.\r\n\uC81C391\uC870:
    \uC811\uADFC \uD69F\uC218\uB294 \uBCC4\uB3C4\uB85C \uC81C\uD55C\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C392\uC870:
    \uCCAB \uC811\uADFC\uC774 \uC2E4\uD328\uD558\uB354\uB77C\uB3C4 \uB2E4\uC74C \uC811\uADFC\uC740
    \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n\uC81C393\uC870: \uB2E4\uC74C \uC811\uADFC\uC5D0\uC11C\uB3C4
    \uC2E4\uD328\uD558\uBA74 \uC2DC\uC2A4\uD15C\uC740 \uD78C\uD2B8\uB97C \uC81C\uACF5\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C394\uC870: \uD78C\uD2B8\uB294 \uC2A4\uD06C\uB864\uBC14\uB098
    \uBC84\uD2BC\uC744 \uAC15\uC870\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C395\uC870:
    \uAC15\uC870\uB41C \uC694\uC18C\uB294 \uC7A0\uC2DC \uD6C4 \uC6D0\uB798 \uC0C1\uD0DC\uB85C
    \uB3CC\uC544\uAC11\uB2C8\uB2E4.\r\n\uC81C396\uC870: \uC6D0\uB798 \uC0C1\uD0DC\uB85C
    \uB3CC\uC544\uAC00\uB3C4 \uAE30\uB2A5\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4.\r\n\uC81C397\uC870:
    \uBB38\uC11C\uC758 \uB9C8\uC9C0\uB9C9\uC740 \uBD84\uBA85\uD788 \uC874\uC7AC\uD569\uB2C8\uB2E4.\r\n\uC81C398\uC870:
    \uB2E4\uB9CC \uC0AC\uC6A9\uC790\uAC00 \uC0DD\uAC01\uD55C \uC704\uCE58\uBCF4\uB2E4
    \uC544\uB798\uC5D0 \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C399\uC870:
    \uB05D\uC774 \uBCF4\uC77C \uB54C\uAE4C\uC9C0 \uACC4\uC18D \uB0B4\uB824\uAC00\uC2ED\uC2DC\uC624.\r\n\uC81C400\uC870:
    \uB05D\uC774 \uBCF4\uC600\uB2E4\uBA74 \uBC84\uD2BC\uC744 \uD655\uC778\uD558\uC2ED\uC2DC\uC624.\r\n\r\n\uC81C401\uC870:
    \uC5EC\uAE30\uAE4C\uC9C0 \uB3C4\uB2EC\uD55C \uC0AC\uC6A9\uC790\uC758 \uC785\uB825\uC740
    \uCDA9\uBD84\uD788 \uC548\uC815\uC801\uC778 \uAC83\uC73C\uB85C \uAC04\uC8FC\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C402\uC870: \uC548\uC815\uC801\uC778
    \uC785\uB825\uC740 \uB2E4\uC74C \uAC80\uC0AC \uC9C4\uD589\uC5D0 \uC801\uD569\uD558\uB2E4\uACE0
    \uD310\uB2E8\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C403\uC870: \uD310\uB2E8
    \uACB0\uACFC\uB294 \uC0AC\uC6A9\uC790\uC5D0\uAC8C \uC644\uC804\uD788 \uACF5\uAC1C\uB418\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C404\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uD544\uC694\uD55C \uACB0\uACFC\uB9CC \uD654\uBA74\uC5D0 \uD45C\uC2DC\uD569\uB2C8\uB2E4.\r\n\uC81C405\uC870:
    \uD544\uC694\uD55C \uACB0\uACFC\uC758 \uBC94\uC704\uB294 \uC2DC\uC2A4\uD15C\uC774
    \uACB0\uC815\uD569\uB2C8\uB2E4.\r\n\uC81C406\uC870: \uC0AC\uC6A9\uC790\uB294
    \uD604\uC7AC \uC5B4\uB5A4 \uD56D\uBAA9\uC774 \uCE21\uC815\uB418\uB294\uC9C0 \uC54C\uC9C0
    \uBABB\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C407\uC870: \uC54C\uC9C0
    \uBABB\uD574\uB3C4 \uAC80\uC0AC\uB294 \uACC4\uC18D \uC9C4\uD589\uB429\uB2C8\uB2E4.\r\n\uC81C408\uC870:
    \uAC80\uC0AC\uAC00 \uBB34\uC5C7\uC744 \uCE21\uC815\uD558\uB294\uC9C0 \uBB3B\uB294
    \uAE30\uB2A5\uC740 \uC81C\uACF5\uB418\uC9C0 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C409\uC870:
    \uC9C8\uBB38\uD558\uC9C0 \uC54A\uC544\uB3C4 \uD544\uC694\uD55C \uBAA8\uB4E0 \uC785\uB825\uC740
    \uC218\uC9D1\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C410\uC870: \uC218\uC9D1\uB41C
    \uC785\uB825\uC740 \uD604\uC7AC \uC138\uC158 \uC548\uC5D0\uC11C\uB9CC \uC0AC\uC6A9\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C411\uC870: \uD604\uC7AC \uC138\uC158\uC774
    \uC5B8\uC81C \uC2DC\uC791\uB418\uC5C8\uB294\uC9C0\uB294 \uBA85\uD655\uD558\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C412\uC870: \uC138\uC158
    \uC2DC\uC791 \uC2DC\uC810\uC740 \uC0AC\uC6A9\uC790\uC758 \uCCAB \uC785\uB825\uBCF4\uB2E4
    \uC774\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C413\uC870: \uB610\uB294
    \uC0AC\uC6A9\uC790\uC758 \uCCAB \uC785\uB825\uACFC \uAC19\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C414\uC870:
    \uC138\uC158 \uC2DC\uC791 \uC2DC\uC810\uC744 \uC815\uD655\uD788 \uC544\uB294
    \uAC83\uC740 \uC9C4\uD589\uC5D0 \uD544\uC694\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C415\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uC138\uC158\uC774 \uC774\uBBF8 \uC9C4\uD589 \uC911\uC774\uB77C\uACE0
    \uD310\uB2E8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C416\uC870: \u2018\uC9C4\uD589
    \uC911\u2019\uC740 \u2018\uAC8C\uC784 \uC911\u2019\uC744 \uC758\uBBF8\uD558\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C417\uC870: \u2018\uAC8C\uC784
    \uC911\u2019\uC774\uB77C\uB294 \uD45C\uD604\uC758 \uC815\uC758\uB294 \uC544\uC9C1
    \uC81C\uACF5\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\r\n\uC81C418\uC870:
    \uC815\uC758\uAC00 \uC5C6\uC5B4\uB3C4 \uC0AC\uC6A9\uC790\uB294 \uACC4\uC18D \uD50C\uB808\uC774\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C419\uC870: \uD50C\uB808\uC774\uD558\uACE0
    \uC788\uB2E4\uB294 \uD45C\uD604 \uC5ED\uC2DC \uC784\uC2DC\uC801\uC73C\uB85C \uC0AC\uC6A9\uB429\uB2C8\uB2E4.\r\n\uC81C420\uC870:
    \uD604\uC7AC \uC218\uD589 \uC911\uC778 \uD589\uB3D9\uC774 \uAC80\uC0AC\uC778\uC9C0
    \uAC8C\uC784\uC778\uC9C0\uB294 \uAD6C\uBD84\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4.\r\n\uC81C421\uC870:
    \uAD6C\uBD84\uD558\uB824\uB294 \uC2DC\uB3C4\uB294 \uC2DC\uC2A4\uD15C\uC5D0 \uAE30\uB85D\uB418\uC9C0
    \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C422\uC870: \uAE30\uB85D\uB418\uB354\uB77C\uB3C4
    \uACB0\uACFC\uC5D0\uB294 \uC601\uD5A5\uC744 \uC8FC\uC9C0 \uC54A\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C423\uC870: \uACB0\uACFC\uC5D0 \uC601\uD5A5\uC744
    \uC8FC\uC9C0 \uC54A\uB294 \uB370\uC774\uD130\uB3C4 \uC874\uC7AC\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C424\uC870: \uC874\uC7AC \uC5EC\uBD80\uB97C
    \uC0AC\uC6A9\uC790\uAC00 \uD655\uC778\uD560 \uBC29\uBC95\uC740 \uC5C6\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C425\uC870: \uD655\uC778\uD560 \uC218 \uC5C6\uB294
    \uC815\uBCF4\uB294 \uC9C0\uAE08 \uB2F9\uC7A5 \uC911\uC694\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C426\uC870:
    \uC911\uC694\uD558\uC9C0 \uC54A\uC740 \uC815\uBCF4\uAC00 \uACC4\uC18D \uD45C\uC2DC\uB418\uB294
    \uAC83\uC740 \uBCF8 \uBB38\uC11C\uC758 \uD2B9\uC9D5\uC785\uB2C8\uB2E4.\r\n\uC81C427\uC870:
    \uBCF8 \uBB38\uC11C\uB294 \uD544\uC694\uD55C \uAC83\uBCF4\uB2E4 \uAE38 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C428\uC870: \uAE38\uB2E4\uB294 \uC0AC\uC2E4\uC740
    \uC2DC\uC2A4\uD15C\uB3C4 \uC778\uC9C0\uD558\uACE0 \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C429\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uBB38\uC11C \uAE38\uC774\uB97C \uC904\uC77C \uACC4\uD68D\uC774
    \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C430\uC870: \uB2E4\uB9CC \uC0AC\uC6A9\uC790\uAC00
    \uC624\uB798 \uBA38\uBB34\uB974\uBA74 \uC77C\uBD80 \uAD6C\uAC04\uC744 \uB2E8\uCD95\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C431\uC870: \uB2E8\uCD95\uB41C \uAD6C\uAC04\uC5D0\uB294
    \uC774\uC804\uACFC \uAC19\uC740 \uC758\uBBF8\uAC00 \uD3EC\uD568\uB41C \uAC83\uC73C\uB85C
    \uAC04\uC8FC\uB429\uB2C8\uB2E4.\r\n\uC81C432\uC870: \uB0B4\uC6A9\uC744 \uB193\uCCE4\uB2E4\uACE0
    \uAC71\uC815\uD560 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C433\uC870:
    \uB193\uCE5C \uB0B4\uC6A9\uC774 \uC815\uB9D0 \uC911\uC694\uD588\uB2E4\uBA74 \uB2E4\uC2DC
    \uD45C\uC2DC\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C434\uC870: \uB2E4\uC2DC
    \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uC911\uC694\uD558\uC9C0 \uC54A\uC558\uC744
    \uAC00\uB2A5\uC131\uC774 \uB192\uC2B5\uB2C8\uB2E4.\r\n\uC81C435\uC870: \uAC00\uB2A5\uC131\uC774
    \uB192\uB2E4\uB294 \uAC83\uC740 \uD655\uC815\uC744 \uC758\uBBF8\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C436\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uB2E4\uC2DC \uD55C\uBC88 \uD655\uC815\uC801\uC778 \uD45C\uD604\uC744
    \uD53C\uD569\uB2C8\uB2E4.\r\n\uC81C437\uC870: \uC774 \uC870\uD56D\uC744 \uC77D\uB294
    \uB3D9\uC548\uC5D0\uB3C4 \uD0C0\uC774\uBA38\uB294 \uACC4\uC18D \uC6C0\uC9C1\uC77C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C438\uC870: \uD0C0\uC774\uBA38\uAC00
    \uBCF4\uC774\uC9C0 \uC54A\uC544\uB3C4 \uC2DC\uAC04\uC740 \uD750\uB97C \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C439\uC870: \uC2DC\uAC04\uC774 \uD750\uB974\uC9C0
    \uC54A\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC5EC\uB3C4 \uC2DC\uC2A4\uD15C\uC740 \uAE30\uB2E4\uB9AC\uACE0
    \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C440\uC870: \uC2DC\uC2A4\uD15C\uC774
    \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2E4\uB294 \uD45C\uD604\uC740 \uBE44\uC720\uC77C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C441\uC870: \uBE44\uC720\uC801 \uD45C\uD604\uC740
    \uC57D\uAD00\uC758 \uD6A8\uB825\uC5D0 \uC601\uD5A5\uC744 \uC8FC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C442\uC870:
    \uC57D\uAD00\uC758 \uD6A8\uB825\uC774 \uBB34\uC5C7\uC778\uC9C0 \uB2E4\uC2DC \uBB3B\uC9C0
    \uB9C8\uC2ED\uC2DC\uC624.\r\n\uC81C443\uC870: \uC774 \uBB38\uC11C\uB294 \uACE7
    \uB05D\uB0A0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C444\uC870: \u2018\uACE7\u2019\uC758
    \uAE30\uC900\uC740 \uC0AC\uC6A9\uC790\uB9C8\uB2E4 \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C445\uC870:
    \uB0A8\uC740 \uC870\uD56D \uC218\uB97C \uC9C1\uC811 \uD655\uC778\uD558\uB294
    \uAC83\uC740 \uD5C8\uC6A9\uB429\uB2C8\uB2E4.\r\n\uC81C446\uC870: \uC870\uD56D
    \uBC88\uD638\uB97C \uBCF4\uACE0 \uC548\uC2EC\uD574\uB3C4 \uB429\uB2C8\uB2E4.\r\n\uC81C447\uC870:
    \uC774\uC81C \uB05D\uC774 \uC2E4\uC81C\uB85C \uAC00\uAE4C\uC6CC\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C448\uC870:
    \uB05D\uC5D0 \uB3C4\uB2EC\uD55C \uB4A4\uC5D0\uB294 \uD55C \uAC00\uC9C0 \uC785\uB825\uB9CC
    \uD544\uC694\uD569\uB2C8\uB2E4.\r\n\uC81C449\uC870: \uADF8 \uC785\uB825\uC740
    \uD654\uBA74 \uD558\uB2E8\uC758 \uBC84\uD2BC \uD074\uB9AD\uC785\uB2C8\uB2E4.\r\n\uC81C450\uC870:
    \uCCAB \uBC88\uC9F8 \uD074\uB9AD \uAE30\uD68C\uAC00 \uADF8\uB300\uB85C \uC131\uACF5\uC73C\uB85C
    \uC774\uC5B4\uC9C0\uC9C0\uB294 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C451\uC870:
    \uCCAB \uBC88\uC9F8 \uBC84\uD2BC \uC811\uADFC \uC2DC \uBB38\uC11C\uAC00 \uCC98\uC74C\uC73C\uB85C
    \uB3CC\uC544\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C452\uC870: \uCC98\uC74C\uC73C\uB85C
    \uB3CC\uC544\uAC00\uB294 \uD604\uC0C1\uC740 \uC758\uB3C4\uB41C \uAC80\uC0AC \uC808\uCC28\uC785\uB2C8\uB2E4.\r\n\uC81C453\uC870:
    \uC758\uB3C4\uB41C \uC808\uCC28\uC774\uBBC0\uB85C \uC2E4\uD328 \uD69F\uC218\uC5D0
    \uD3EC\uD568\uB418\uC9C0 \uC54A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C454\uC870:
    \uC0AC\uC6A9\uC790\uB294 \uB2E4\uC2DC \uAC19\uC740 \uAE38\uC744 \uB0B4\uB824\uC624\uBA74
    \uB429\uB2C8\uB2E4.\r\n\uC81C455\uC870: \uB450 \uBC88\uC9F8 \uAE38\uC740 \uCCAB
    \uBC88\uC9F8\uBCF4\uB2E4 \uC9E7\uAC8C \uB290\uAEF4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C456\uC870:
    \uC9E7\uAC8C \uB290\uAEF4\uC838\uB3C4 \uC870\uD56D \uC218\uB294 \uADF8\uB300\uB85C\uC77C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C457\uC870: \uC870\uD56D \uC218\uAC00
    \uC904\uC5B4\uB4E4\uC5B4\uB3C4 \uC0AC\uC6A9\uC790\uB294 \uC54C \uD544\uC694\uAC00
    \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C458\uC870: \uC911\uC694\uD55C \uAC83\uC740
    \uB2E4\uC2DC \uD558\uB2E8\uC5D0 \uB3C4\uB2EC\uD558\uB294 \uAC83\uC785\uB2C8\uB2E4.\r\n\uC81C459\uC870:
    \uB450 \uBC88\uC9F8 \uD558\uB2E8 \uB3C4\uB2EC \uD6C4 \uBC84\uD2BC\uC740 \uB354
    \uC774\uC0C1 \uD68C\uD53C\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C460\uC870:
    \uD68C\uD53C\uD558\uC9C0 \uC54A\uB294 \uBC84\uD2BC\uC740 \uC815\uC0C1\uC801\uC73C\uB85C
    \uD074\uB9AD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C461\uC870: \uC815\uC0C1
    \uD074\uB9AD\uC774 \uD655\uC778\uB418\uBA74 \uBB38\uC11C \uAC80\uC0AC\uAC00 \uC885\uB8CC\uB429\uB2C8\uB2E4.\r\n\uC81C462\uC870:
    \uAC80\uC0AC \uC885\uB8CC \uD6C4 \uBCF8 \uC57D\uAD00\uC740 \uB354 \uC774\uC0C1
    \uD654\uBA74\uC5D0 \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C463\uC870:
    \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC544\uB3C4 \uC2DC\uC2A4\uD15C\uC740 \uB0B4\uC6A9\uC744
    \uAE30\uC5B5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C464\uC870: \uC0AC\uC6A9\uC790\uAC00
    \uB0B4\uC6A9\uC744 \uAE30\uC5B5\uD560 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C465\uC870:
    \uC5EC\uAE30\uAE4C\uC9C0 \uC77D\uC5C8\uB2E4\uBA74 \uCDA9\uBD84\uD788 \uB9CE\uC774
    \uC77D\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uC81C466\uC870: \uC2E4\uC81C\uB85C \uBAA8\uB4E0
    \uBB38\uC7A5\uC744 \uC77D\uC5C8\uB294\uC9C0\uB294 \uC911\uC694\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C467\uC870:
    \uC2DC\uC2A4\uD15C\uC740 \uC77D\uAE30\uBCF4\uB2E4 \uB3C4\uB2EC\uC744 \uD655\uC778\uD569\uB2C8\uB2E4.\r\n\uC81C468\uC870:
    \uB3C4\uB2EC\uC740 \uD604\uC7AC \uBB38\uC11C\uC758 \uB9C8\uC9C0\uB9C9 \uC704\uCE58\uB97C
    \uAE30\uC900\uC73C\uB85C \uD310\uB2E8\uB429\uB2C8\uB2E4.\r\n\uC81C469\uC870:
    \uB9C8\uC9C0\uB9C9 \uC704\uCE58\uB294 \uC774\uC81C \uBA40\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C470\uC870:
    \uC2A4\uD06C\uB864\uBC14\uAC00 \uAC70\uC758 \uB05D\uC5D0 \uB2FF\uC544 \uC788\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C471\uC870: \uC544\uC9C1 \uB2FF\uC9C0
    \uC54A\uC558\uB2E4\uBA74 \uC870\uAE08 \uB354 \uB0B4\uB824\uAC00\uC2ED\uC2DC\uC624.\r\n\uC81C472\uC870:
    \uBC84\uD2BC\uC774 \uBCF4\uC778\uB2E4\uBA74 \uCEE4\uC11C\uB97C \uCC9C\uCC9C\uD788
    \uC774\uB3D9\uD574\uB3C4 \uB429\uB2C8\uB2E4.\r\n\uC81C473\uC870: \uBE60\uB974\uAC8C
    \uC774\uB3D9\uD574\uB3C4 \uC2DC\uC2A4\uD15C\uC740 \uAC10\uC9C0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C474\uC870:
    \uCCAB \uBC88\uC9F8 \uC7A5\uB09C \uC774\uD6C4\uC5D0\uB294 \uCC9C\uCC9C\uD788
    \uC811\uADFC\uD560 \uD544\uC694\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC81C475\uC870:
    \uB450 \uBC88\uC9F8 \uBC84\uD2BC\uC740 \uB3C4\uB9DD\uAC00\uC9C0 \uC54A\uC744
    \uC608\uC815\uC785\uB2C8\uB2E4.\r\n\uC81C476\uC870: \uC608\uC815\uB300\uB85C
    \uC791\uB3D9\uD558\uC9C0 \uC54A\uC73C\uBA74 \uB2E4\uC2DC \uC2DC\uB3C4\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C477\uC870: \uC7AC\uC2DC\uB3C4\uB294 \uC5B8\uC81C\uB4E0
    \uD5C8\uC6A9\uB429\uB2C8\uB2E4.\r\n\uC81C478\uC870: \uC0AC\uC6A9\uC790\uB294
    \uC774 \uBB38\uC11C\uC5D0\uC11C \uAC8C\uC784 \uC624\uBC84\uAC00 \uB418\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C479\uC870: \uBB38\uC11C\uAC00 \uAE38\uC5B4\uB3C4
    \uC2E4\uD328 \uC0C1\uD0DC\uB294 \uBC1C\uC0DD\uD558\uC9C0 \uC54A\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C480\uC870: \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294
    \uD55C \uC9C4\uD589\uC740 \uACC4\uC18D \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n\uC81C481\uC870:
    \uD3EC\uAE30\uD558\uB354\uB77C\uB3C4 \uB2E4\uC2DC \uC2DC\uC791\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C482\uC870:
    \uB2E4\uC2DC \uC2DC\uC791\uD558\uBA74 \uCC98\uC74C\uBD80\uD130 \uBCFC \uAC00\uB2A5\uC131\uC774
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C483\uC870: \uADF8\uB7EC\uBBC0\uB85C \uC9C0\uAE08
    \uB05D\uAE4C\uC9C0 \uAC00\uB294 \uD3B8\uC774 \uD3B8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C484\uC870:
    \uC774 \uBB38\uC7A5\uC740 \uC0AC\uC6A9\uC790 \uD3B8\uC758\uB97C \uC704\uD55C
    \uC870\uC5B8\uC785\uB2C8\uB2E4.\r\n\uC81C485\uC870: \uC2DC\uC2A4\uD15C\uC740
    \uB4DC\uBB3C\uAC8C \uC720\uC6A9\uD55C \uC870\uC5B8\uB3C4 \uC81C\uACF5\uD569\uB2C8\uB2E4.\r\n\uC81C486\uC870:
    \uC720\uC6A9\uD55C \uC870\uC5B8\uC774 \uD56D\uC0C1 \uC81C\uACF5\uB418\uB294 \uAC83\uC740
    \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC81C487\uC870: \uC774\uBC88 \uC870\uC5B8\uC740
    \uBE44\uAD50\uC801 \uBBFF\uC744 \uB9CC\uD569\uB2C8\uB2E4.\r\n\uC81C488\uC870:
    \uB0A8\uC740 \uC870\uD56D\uC740 \uC774\uC81C \uB9E4\uC6B0 \uC801\uC2B5\uB2C8\uB2E4.\r\n\uC81C489\uC870:
    \uD654\uBA74 \uC544\uB798\uCABD\uC744 \uACC4\uC18D \uD655\uC778\uD558\uC2ED\uC2DC\uC624.\r\n\uC81C490\uC870:
    \uC2DC\uC791 \uBC84\uD2BC\uC740 \uB9C8\uC9C0\uB9C9 \uC870\uD56D \uC544\uB798\uC5D0
    \uC704\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C491\uC870: \uBC84\uD2BC\uC758
    \uBB38\uAD6C\uB294 \u2018\uC57D\uAD00\uC5D0 \uB3D9\uC758\uD558\uACE0 \uC2DC\uC791\uD558\uAE30\u2019\uC785\uB2C8\uB2E4.\r\n\uC81C492\uC870:
    \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uC0AC\uC6A9\uC790\uC758 \uC2E4\uD589 \uC758\uC0AC\uAC00
    \uD655\uC778\uB429\uB2C8\uB2E4.\r\n\uC81C493\uC870: \uC2E4\uD589 \uC758\uC0AC
    \uD655\uC778\uC740 \uB2E4\uC74C \uAC80\uC0AC \uC9C4\uD589 \uC870\uAC74\uC73C\uB85C
    \uC0AC\uC6A9\uB429\uB2C8\uB2E4.\r\n\uC81C494\uC870: \uB2E4\uC74C \uAC80\uC0AC\uC5D0\uC11C\uB3C4
    \uC2DC\uC791 \uBC84\uD2BC\uC774 \uB4F1\uC7A5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C495\uC870:
    \uC2DC\uC791 \uBC84\uD2BC\uC774 \uBA87 \uBC88 \uB354 \uB4F1\uC7A5\uD560\uC9C0\uB294
    \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uC81C496\uC870: \uAC8C\uC784\uC774
    \uC2E4\uC81C\uB85C \uC5B8\uC81C \uC2DC\uC791\uB418\uB294\uC9C0\uB3C4 \uC544\uC9C1
    \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\r\n\uC81C497\uC870:
    \uC9C0\uAE08\uAE4C\uC9C0\uC758 \uACFC\uC815\uC774 \uC900\uBE44 \uAC80\uC0AC\uB77C\uB294
    \uC124\uBA85\uC740 \uACC4\uC18D \uC720\uD6A8\uD569\uB2C8\uB2E4.\r\n\uC81C498\uC870:
    \uC801\uC5B4\uB3C4 \uC2DC\uC2A4\uD15C\uC740 \uADF8\uB807\uAC8C \uD45C\uC2DC\uD558\uACE0
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC81C499\uC870: \uBCF8 \uC57D\uAD00\uC758 \uB05D\uC740
    \uC0C8\uB85C\uC6B4 \uC2E4\uD589 \uB2E8\uACC4\uC758 \uC2DC\uC791\uC744 \uC758\uBBF8\uD569\uB2C8\uB2E4.\r\n\uC81C500\uC870:
    \uB05D\uAE4C\uC9C0 \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4. \uC774\uC81C \uC57D\uAD00\uC5D0
    \uB3D9\uC758\uD558\uACE0 \uC2DC\uC791\uD558\uAE30 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694.\r\n"
