      m_Calls: []
  m_text: "\uC774\uC6A9\uC57D\uAD00 \uBC0F \uB370\uC774\uD130 \uAC80\uC0AC \uB3D9\uC758\uC11C\r\n\r\n\uC81C1\uC870
    \uBAA9\uC801\r\n\uBCF8 \uC57D\uAD00\uC740 \uC2E4\uD589 \uC2DC\uC2A4\uD15C\uC758
    \uC774\uC6A9 \uC808\uCC28\uC640 \uB370\uC774\uD130 \uAC80\uC0AC \uBC29\uBC95\uC744
    \uADDC\uC815\uD569\uB2C8\uB2E4.\r\n\r\n\uC81C2\uC870 \uC774\uC6A9\uC790\uC758
    \uC758\uBB34\r\n\uC774\uC6A9\uC790\uB294 \uD654\uBA74\uC5D0 \uD45C\uC2DC\uB41C
    \uC548\uB0B4 \uC0AC\uD56D\uC744 \uC219\uC9C0\uD558\uC5EC\uC57C \uD569\uB2C8\uB2E4.\r\n\r\n\uC81C3\uC870
    \uC815\uBCF4 \uCC98\uB9AC\r\n\uC2DC\uC2A4\uD15C\uC740 \uC785\uB825\uB41C \uC815\uBCF4\uB97C
    \uB0B4\uBD80 \uAC80\uC0AC \uC808\uCC28\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C4\uC870
    \uAC80\uC0AC \uACFC\uC815\r\n\uBAA8\uB4E0 \uAC80\uC0AC\uB294 \uC815\uD574\uC9C4
    \uC808\uCC28\uC5D0 \uB530\uB77C \uC9C4\uD589\uB429\uB2C8\uB2E4.\r\n\r\n\uC81C5\uC870
    \uC2E4\uD589 \uC870\uAC74\r\n\uD2B9\uC815 \uC870\uAC74\uC774 \uCDA9\uC871\uB418\uBA74
    \uC0C8\uB85C\uC6B4 \uC2E4\uD589 \uB2E8\uACC4\uAC00 \uC81C\uACF5\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4\n\uC2DC\uC2A4\uD15C\uC740 <link=\"hidden_start\">START</link>
    \uC0C1\uD0DC\uC758 \uAC80\uC0AC \uAE30\uB85D\uC744 \uB0B4\uBD80 \uCC98\uB9AC
    \uC808\uCC28\uC5D0 \uD3EC\uD568\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C6\uC870
    \uC0AC\uC6A9\uC790 \uD655\uC778\r\n\uC774\uC6A9\uC790\uB294 \uD45C\uC2DC\uB41C
    \uB0B4\uC6A9\uC744 \uC9C1\uC811 \uD655\uC778\uD558\uC5EC\uC57C \uD569\uB2C8\uB2E4.\r\n\r\n\uC81C7\uC870
    \uB370\uC774\uD130 \uBD84\uB958\r\n\uC785\uB825 \uB370\uC774\uD130\uB294 \uAC80\uC0AC
    \uACB0\uACFC\uC5D0 \uB530\uB77C \uBD84\uB958\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C8\uC870
    \uCC98\uB9AC \uC21C\uC11C\r\n\uC2DC\uC2A4\uD15C\uC774 \uC81C\uACF5\uD558\uB294
    \uC21C\uC11C\uB294 \uBCC0\uACBD\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C9\uC870
    \uAE30\uB85D \uBCF4\uAD00\r\n\uAC80\uC0AC \uAE30\uB85D\uC740 \uC2DC\uC2A4\uD15C
    \uB0B4\uBD80\uC5D0 \uC784\uC2DC\uB85C \uC800\uC7A5\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C10\uC870
    \uAC80\uC0AC \uC885\uB8CC\r\n\uBB38\uC11C\uC758 \uB9C8\uC9C0\uB9C9\uC5D0 \uB3C4\uB2EC\uD558\uB294
    \uD589\uC704\uB294 \uAC80\uC0AC \uC644\uB8CC\uB97C \uBCF4\uC7A5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC57D\uAD00
    \uD655\uC778 \uC644\uB8CC\r\nSTART DATA : NOT FOUND"
