  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6621872311939327177}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=34><b>\uC2E4\uD589 \uC2DC\uC2A4\uD15C \uC774\uC6A9\uC57D\uAD00 \uBC0F
    \uB370\uC774\uD130 \uAC80\uC0AC \uB3D9\uC758\uC11C</b></size>\n<size=22>(\uBC84\uC804
    5.0.21 - \uC77C\uBD80 \uB370\uC774\uD130\uAC00 \uC190\uC0C1\uB418\uC5C8\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4)</size>\n\n<b>\uC81C1\uC870 (\uBAA9\uC801)</b>\n\uBCF8
    \uC57D\uAD00\uC740 \uAC8C\uC784 \uC2E4\uD589 \uC2DC\uC2A4\uD15C(\uC774\uD558
    \"\uC2DC\uC2A4\uD15C\")\uC758 \uC774\uC6A9 \uC808\uCC28\uC640 \uC2E4\uD589 \uB370\uC774\uD130
    \uAC80\uC0AC \uBC29\uBC95\uC744 \uADDC\uC815\uD569\uB2C8\uB2E4. \uC774\uC6A9\uC790\uB294
    \uC57D\uAD00\uC758 \uB0B4\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4\uC5D0\uB9CC \uB2E4\uC74C
    \uB2E8\uACC4\uB85C \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<b>\uC81C2\uC870
    (\uC6A9\uC5B4\uC758 \uC815\uC758)</b>\n1. \"\uC2E4\uD589 \uBC84\uD2BC\"\uC774\uB780
    \uAC8C\uC784\uC744 \uC2DC\uC791\uD558\uAE30 \uC704\uD574 \uB204\uB974\uB294 \uBC84\uD2BC\uC744
    \uB9D0\uD569\uB2C8\uB2E4.\n2. \"\uAC00\uC9DC \uBC84\uD2BC\"\uC774\uB780 \uC2E4\uD589
    \uBC84\uD2BC\uCC98\uB7FC \uBCF4\uC774\uC9C0\uB9CC \uB20C\uB7EC\uB3C4 \uC544\uBB34
    \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uB294 \uD45C\uC2DC\uB97C \uB9D0\uD569\uB2C8\uB2E4.\n3.
    \"\uC190\uC0C1 \uB370\uC774\uD130\"\uB780 \uC624\uB958\uB85C \uC778\uD574 \uC6D0\uB798
    \uC790\uB9AC\uC5D0\uC11C \uBC97\uC5B4\uB098 \uB2E4\uB978 \uBB38\uC7A5 \uC0AC\uC774\uC5D0
    \uC11E\uC5EC \uBC84\uB9B0 \uB370\uC774\uD130\uB97C \uB9D0\uD569\uB2C8\uB2E4.\n\n<b>\uC81C3\uC870
    (\uC57D\uAD00\uC758 \uD6A8\uB825)</b>\n\uBCF8 \uC57D\uAD00\uC740 \uD654\uBA74\uC5D0
    \uD45C\uC2DC\uB41C \uC21C\uAC04\uBD80\uD130 \uD6A8\uB825\uC774 \uBC1C\uC0DD\uD558\uBA70,
    \uC774\uC6A9\uC790\uAC00 \uC2A4\uD06C\uB864\uC744 \uB0B4\uB9AC\uB294 \uC18D\uB3C4\uC640
    \uAD00\uACC4\uC5C6\uC774 \uB3D9\uC77C\uD558\uAC8C \uC801\uC6A9\uB429\uB2C8\uB2E4.\n\n<b>\uC81C4\uC870
    (\uC774\uC6A9\uC790\uC758 \uC758\uBB34)</b>\n\uC774\uC6A9\uC790\uB294 \uD654\uBA74\uC5D0
    \uD45C\uC2DC\uB41C \uBAA8\uB4E0 \uC548\uB0B4 \uC0AC\uD56D\uC744 \uC9C1\uC811
    \uC77D\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uBC84\uD2BC\uCC98\uB7FC \uBCF4\uC774\uB294
    \uAE00\uC790\uB97C \uBB34\uC791\uC815 \uB204\uB974\uB294 \uD589\uC704\uB294 \uAC80\uC0AC
    \uACB0\uACFC\uC5D0 \uC544\uBB34\uB7F0 \uC601\uD5A5\uC744 \uC8FC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n<b>\uC81C5\uC870
    (\uC815\uBCF4 \uCC98\uB9AC)</b>\n\uC2DC\uC2A4\uD15C\uC740 \uC774\uC6A9\uC790\uC758
    \uD074\uB9AD, \uB9C8\uC6B0\uC2A4 \uC704\uCE58, \uBA38\uBB47\uAC70\uB9B0 \uC2DC\uAC04\uC744
    \uB0B4\uBD80 \uAC80\uC0AC \uC808\uCC28\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uC218\uC9D1\uB41C \uC815\uBCF4\uB294 \uAC80\uC0AC\uAC00 \uB05D\uB098\uBA74 \uC989\uC2DC
    \uD3D0\uAE30\uB429\uB2C8\uB2E4.\n\n<b>\uC81C6\uC870 (\uAC80\uC0AC \uACFC\uC815)</b>\n\uBAA8\uB4E0
    \uAC80\uC0AC\uB294 \uC815\uD574\uC9C4 \uC808\uCC28\uC5D0 \uB530\uB77C \uC9C4\uD589\uB429\uB2C8\uB2E4.
    \uB2E8, \uCC55\uD130 5 \uC774\uD6C4\uC758 \uAC80\uC0AC\uB294 \uC77C\uBD80 \uC808\uCC28\uAC00
    \uC190\uC0C1\uB41C \uC0C1\uD0DC\uB85C \uC9C4\uD589\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<b>\uC81C7\uC870
    (\uC624\uB958 \uD604\uC0C1)</b>\n\uD654\uBA74\uC774 \uAE5C\uBE61\uC774\uAC70\uB098
    \uAE00\uC790\uAC00 \uD754\uB4E4\uB9AC\uB294 \uD604\uC0C1\uC740 \uC815\uC0C1\uC801\uC778
    \uC624\uB958\uC785\uB2C8\uB2E4. \uC774\uC6A9\uC790\uB294 \uC774\uB97C \uC2E0\uACE0\uD558\uC9C0
    \uC54A\uC544\uB3C4 \uB418\uBA70, \uC624\uD788\uB824 \uC8FC\uC758 \uAE4A\uAC8C
    \uC0B4\uD3B4\uBCF4\uB294 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4.\n\n<b>\uC81C8\uC870
    (\uC7AC\uC2DC\uC791 \uC815\uCC45)</b>\n\uAC80\uC0AC\uC5D0 \uC2E4\uD328\uD55C
    \uC774\uC6A9\uC790\uB294 \uC7AC\uC2DC\uC791 \uC808\uCC28\uC5D0 \uB530\uB77C \uCC98\uC74C\uBD80\uD130
    \uB2E4\uC2DC \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\n<b>\uC81C9\uC870 (\uB370\uC774\uD130
    \uBD84\uB958)</b>\n\uC785\uB825 \uB370\uC774\uD130\uB294 \uAC80\uC0AC \uACB0\uACFC\uC5D0
    \uB530\uB77C \"\uC815\uC0C1\", \"\uBCF4\uB958\", \"\uC190\uC0C1\"\uC73C\uB85C
    \uBD84\uB958\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \"\uC190\uC0C1\"\uC73C\uB85C
    \uBD84\uB958\uB41C \uB370\uC774\uD130\uB294 \uB300\uAE30 \uC0C1\uD0DC\uB85C \uBCF4\uAD00\uB429\uB2C8\uB2E4.\n\n<b>\uC81C10\uC870
    (\uCC98\uB9AC \uC21C\uC11C)</b>\n\uC2DC\uC2A4\uD15C\uC774 \uC81C\uACF5\uD558\uB294
    \uCC98\uB9AC \uC21C\uC11C\uB294 \uC0AC\uC804 \uC548\uB0B4 \uC5C6\uC774 \uBCC0\uACBD\uB420
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC774\uC6A9\uC790\uB294 \uD654\uBA74\uC5D0
    \uBCF4\uC774\uB294 \uC21C\uC11C\uAC00 \uD56D\uC0C1 \uC62C\uBC14\uB974\uB2E4\uACE0
    \uAC00\uC815\uD574\uC11C\uB294 \uC548 \uB429\uB2C8\uB2E4.\n\n<b>\uC81C11\uC870
    (\uB370\uC774\uD130 \uBCF5\uAD6C)</b>\n\uC190\uC0C1 \uB370\uC774\uD130\uB294
    \uBCF5\uAD6C\uB418\uB294 \uACFC\uC815\uC5D0\uC11C \uC6D0\uB798 \uBB38\uC7A5 \uC0AC\uC774\uC5D0
    \uB07C\uC5B4\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBCF5\uAD6C\uB41C \uB370\uC774\uD130\uB294
    \uC8FC\uBCC0 \uAE00\uC790\uC640 \uB611\uAC19\uC740 \uBAA8\uC591\uC73C\uB85C \uD45C\uC2DC\uB418\uBBC0\uB85C
    \uAC89\uBAA8\uC2B5\uB9CC\uC73C\uB85C\uB294 \uAD6C\uBCC4\uD558\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4.\n\n<b>\uC81C12\uC870
    (\uC2E4\uD589 \uC870\uAC74)</b>\n\uD2B9\uC815 \uC870\uAC74\uC774 \uCDA9\uC871\uB418\uBA74
    \uC0C8\uB85C\uC6B4 \uC2E4\uD589 \uB2E8\uACC4\uAC00 \uC81C\uACF5\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \uC2DC\uC2A4\uD15C\uC740 <link=\"hidden_start\">START</link>
    \uC0C1\uD0DC\uC758 \uAC80\uC0AC \uAE30\uB85D\uC744 \uB0B4\uBD80 \uCC98\uB9AC
    \uC808\uCC28\uC5D0 \uD3EC\uD568\uD560 \uC218 \uC788\uC73C\uBA70, \uC774 \uAE30\uB85D\uC740
    \uC774\uC6A9\uC790\uAC00 \uC9C1\uC811 \uD655\uC778\uD55C \uACBD\uC6B0\uC5D0\uB9CC
    \uC720\uD6A8\uD569\uB2C8\uB2E4.\n\n<b>\uC81C13\uC870 (\uBC84\uD2BC\uC758 \uC704\uCE58)</b>\n\uC2E4\uD589
    \uBC84\uD2BC\uC740 \uD56D\uC0C1 \uD654\uBA74 \uC544\uB798\uCABD\uC774\uB098 \uBB38\uC11C\uC758
    \uB9C8\uC9C0\uB9C9\uC5D0 \uC788\uB2E4\uACE0 \uBCF4\uC7A5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n<b>\uC81C14\uC870
    (\uAE30\uB85D \uBCF4\uAD00)</b>\n\uAC80\uC0AC \uAE30\uB85D\uC740 \uC2DC\uC2A4\uD15C
    \uB0B4\uBD80\uC5D0 \uC784\uC2DC\uB85C \uC800\uC7A5\uB420 \uC218 \uC788\uC73C\uBA70,
    \uC774\uC6A9\uC790\uB294 \uC5B8\uC81C\uB4E0\uC9C0 \uC5F4\uB78C\uC744 \uC694\uCCAD\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB2E8, \uC5F4\uB78C \uC694\uCCAD \uBC84\uD2BC\uC740
    \uD604\uC7AC \uC810\uAC80 \uC911\uC785\uB2C8\uB2E4.\n\n<b>\uC81C15\uC870 (\uCC45\uC784\uC758
    \uC81C\uD55C)</b>\n\uC774\uC6A9\uC790\uAC00 \uAC00\uC9DC \uBC84\uD2BC\uC744 \uB20C\uB7EC
    \uBC1C\uC0DD\uD55C \uC2DC\uAC04 \uB0AD\uBE44\uC5D0 \uB300\uD574 \uC2DC\uC2A4\uD15C\uC740
    \uCC45\uC784\uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n<b>\uC81C16\uC870 (\uC57D\uAD00\uC758
    \uBCC0\uACBD)</b>\n\uC2DC\uC2A4\uD15C\uC740 \uD544\uC694\uD55C \uACBD\uC6B0 \uC57D\uAD00\uC758
    \uC77C\uBD80 \uC870\uD56D\uC744 \uC608\uACE0 \uC5C6\uC774 \uC190\uC0C1\uC2DC\uD0AC
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<b>\uC81C17\uC870 (\uAC80\uC0AC \uC885\uB8CC)</b>\n\uBB38\uC11C\uC758
    \uB9C8\uC9C0\uB9C9\uC5D0 \uB3C4\uB2EC\uD558\uB294 \uD589\uC704\uB294 \uAC80\uC0AC
    \uC644\uB8CC\uB97C \uBCF4\uC7A5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB9C8\uC9C0\uB9C9
    \uC904\uC5D0\uB294 \uC2E4\uD589 \uBC84\uD2BC\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n<b>\uBD80\uCE59</b>\n\uBCF8
    \uC57D\uAD00\uC740 2026\uB144 11\uC6D4\uBD80\uD130 \uC2DC\uD589\uD569\uB2C8\uB2E4.\n\n\n\uC57D\uAD00
    \uD655\uC778 \uC644\uB8CC\n\uC2E4\uD589 \uB370\uC774\uD130 : \uCC3E\uC744 \uC218
    \uC5C6\uC74C"
  m_isRightToLeft: 0
